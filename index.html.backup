<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Nɛpɛm · Kenyang for the whole family</title>

<meta name="description" content="Learn Kenyang together. Build sentences, solve a Kenyang crossword, play a family duel. For the Bayangi diaspora and anyone who wants the language back.">
<meta property="og:title" content="Nɛpɛm · Kenyang for the whole family">
<meta property="og:description" content="Build a real Kenyang sentence, then sit down with your children and solve a Kenyang crossword.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://aer220.github.io/kenyang_language/">
<meta property="og:image" content="https://aer220.github.io/kenyang_language/share.png">
<meta name="twitter:card" content="summary_large_image">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Gentium+Book+Plus:ital,wght@0,400;0,700;1,400&family=Archivo:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
/* ═══════════════════════════════════════════════════════════════════════════
   This is a family tool, not a children's app.

   In a diaspora family the parent often cannot speak Kenyang either. They
   understand it, they are embarrassed they cannot reply, and the grandmother
   is the real authority. So nothing here talks down, and the two headline
   activities are things two people do side by side.

   Colour carries grammar. Each role keeps its hue everywhere, so you start
   reading the colour before you read the word.
   ═══════════════════════════════════════════════════════════════════════════ */
:root{
  --who:#42E3BC; --not:#FF6A55; --root:#FFFFFF; --when:#B98BFF; --place:#FFC94D;
  --p1:#5BC8FF;            /* player one in the duel */
  --p2:#FF9ECF;            /* player two, and anything about family */
  --base:#060910;
  --lift:rgba(255,255,255,.04); --lift2:rgba(255,255,255,.075);
  --edge:rgba(255,255,255,.09); --edge-hi:rgba(255,255,255,.22);
  --text:#EEF2F7; --mute:#8494A4;
  --serif:"Gentium Book Plus",Georgia,serif;
  --sans:"Archivo",system-ui,sans-serif;
  --mx:50%; --my:18%; --r:20px;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:var(--base);color:var(--text);font-family:var(--sans);
  font-size:17px;line-height:1.62;overflow-x:hidden;-webkit-font-smoothing:antialiased}

.sky{position:fixed;inset:-25%;z-index:0;pointer-events:none;filter:blur(92px);opacity:.5}
.blob{position:absolute;border-radius:50%}
.b1{width:52vw;height:52vw;left:-8%;top:-8%;background:#0E7A63;animation:d1 36s ease-in-out infinite}
.b2{width:42vw;height:42vw;right:-5%;top:4%;background:#5B3A9E;animation:d2 43s ease-in-out infinite}
.b3{width:46vw;height:46vw;left:16%;bottom:-12%;background:#8A4A1E;animation:d3 49s ease-in-out infinite}
.b4{width:32vw;height:32vw;right:12%;bottom:4%;background:#A8365C;animation:d4 40s ease-in-out infinite}
@keyframes d1{0%,100%{transform:none}50%{transform:translate(9vw,7vh) scale(1.16)}}
@keyframes d2{0%,100%{transform:none}50%{transform:translate(-8vw,10vh) scale(1.1)}}
@keyframes d3{0%,100%{transform:none}50%{transform:translate(7vw,-9vh) scale(1.2)}}
@keyframes d4{0%,100%{transform:none}50%{transform:translate(-6vw,-6vh) scale(1.14)}}
#field{position:fixed;inset:0;z-index:0;pointer-events:none}
.aura{position:fixed;inset:0;z-index:0;pointer-events:none;
  background:radial-gradient(640px circle at var(--mx) var(--my),rgba(255,201,77,.10),transparent 60%)}

.wrap{max-width:1160px;margin:0 auto;padding:0 clamp(16px,3vw,32px);position:relative;z-index:1}
a{color:inherit}
:focus-visible{outline:2px solid var(--place);outline-offset:3px;border-radius:6px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.glass{background:var(--lift);border:1px solid var(--edge);border-radius:var(--r);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}

nav{display:flex;align-items:center;justify-content:space-between;gap:12px;
  padding:16px 0;flex-wrap:wrap}
.brand{font-family:var(--serif);font-size:25px;font-weight:700;letter-spacing:-.01em}
.brand small{display:block;font-family:var(--sans);font-size:10.5px;font-weight:400;
  color:var(--mute);letter-spacing:.11em;margin-top:2px}
.nav-r{display:flex;align-items:center;gap:3px;flex-wrap:wrap}
.nav-r .q{text-decoration:none;color:var(--mute);font-size:14.5px;padding:8px 12px;
  border-radius:99px;transition:color .2s,background .2s;cursor:pointer;
  background:none;border:none;font-family:inherit}
.nav-r .q:hover{color:var(--text);background:rgba(255,255,255,.07)}
.cta{display:inline-flex;align-items:center;gap:9px;text-decoration:none;border:none;
  font-family:inherit;font-weight:600;font-size:15px;padding:11px 20px;border-radius:99px;
  cursor:pointer;color:#06090F;background:linear-gradient(135deg,var(--place),#FF9E2C);
  box-shadow:0 6px 24px rgba(255,201,77,.24);transition:transform .22s,box-shadow .32s}
.cta:hover{transform:translateY(-2px);box-shadow:0 12px 40px rgba(255,201,77,.45)}
.cta .dot{width:7px;height:7px;border-radius:99px;background:#06090F;opacity:.5;
  animation:pulse 2.4s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:.25}50%{opacity:.85}}

/* ── the builder, top of the page, for everybody ─────────────── */
.hero{padding:22px 0 4px}
.hlead{font-size:16px;color:var(--mute);margin:0 0 22px;max-width:44em}
.hlead b{color:var(--text);font-weight:600}
.built{font-family:var(--serif);font-size:clamp(32px,6.6vw,84px);line-height:1.05;
  margin:0 0 12px;letter-spacing:-.03em;display:flex;flex-wrap:wrap;gap:0 .24em;
  align-items:baseline;min-height:1.1em}
.m{display:inline-block;position:relative}
.m.in{animation:pop .4s cubic-bezier(.2,.9,.25,1) both}
@keyframes pop{from{opacity:0;transform:translateY(.14em) scale(.96)}to{opacity:1;transform:none}}
.m-who{color:var(--who)} .m-not{color:var(--not)} .m-root{color:var(--root)}
.m-when{color:var(--when)} .m-place{color:var(--place)}
.m::after{content:"";position:absolute;left:0;right:0;bottom:-.08em;height:2px;
  background:currentColor;opacity:.26;border-radius:2px}
.gloss{font-family:var(--serif);font-style:italic;font-size:clamp(18px,2.2vw,26px);
  color:var(--mute);margin:0 0 24px;min-height:1.4em}
.g-who{color:var(--who);font-style:normal} .g-not{color:var(--not);font-style:normal}
.controls{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:11px}
.ctl{padding:13px 14px}
.ctl-label{font-size:11.5px;color:var(--mute);margin:0 0 9px;display:flex;
  align-items:center;gap:8px;letter-spacing:.09em}
.swatch{width:8px;height:8px;border-radius:99px;flex:none}
.opts{display:flex;flex-wrap:wrap;gap:6px}
.opt{font-family:var(--serif);font-size:17px;background:none;color:var(--mute);
  border:1px solid var(--edge);border-radius:99px;padding:6px 13px;cursor:pointer;transition:all .2s}
.opt:hover{color:var(--text);border-color:var(--edge-hi);transform:translateY(-1px)}
.opt[aria-pressed="true"]{color:#06090F;font-weight:700;border-color:transparent}
.c-who .swatch,.c-who .opt[aria-pressed="true"]{background:var(--who)}
.c-when .swatch,.c-when .opt[aria-pressed="true"]{background:var(--when)}
.c-not .swatch,.c-not .opt[aria-pressed="true"]{background:var(--not)}
.c-place .swatch,.c-place .opt[aria-pressed="true"]{background:var(--place)}
.c-verb .swatch,.c-verb .opt[aria-pressed="true"]{background:var(--root);color:#06090F}
.recipe{font-size:14px;color:var(--mute);margin:16px 0 0}
.recipe code{font-family:var(--sans);color:var(--text)}
.legend{display:flex;flex-wrap:wrap;gap:15px;margin:14px 0 0;font-size:12.5px;color:var(--mute)}
.legend span{display:flex;align-items:center;gap:7px}
.legend i{width:9px;height:9px;border-radius:99px;display:inline-block}

/* ── sections ─────────────────────────────────────────────────── */
.rule{border:none;border-top:1px solid var(--edge);margin:42px 0 0}
.sec{padding:40px 0}
h2.big{font-family:var(--serif);font-size:clamp(25px,3.3vw,39px);line-height:1.22;
  font-weight:700;margin:0 0 12px;max-width:27em}
h2.big b{color:var(--place)} h2.big em{color:var(--p2);font-style:normal}
.lead{color:var(--mute);margin:0 0 24px;max-width:44em}

/* ── choose an activity ───────────────────────────────────────── */
.picks{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}
.pickc{position:relative;text-align:left;border:1px solid var(--edge);border-radius:var(--r);
  padding:19px 18px;background:var(--lift);cursor:pointer;color:inherit;font-family:inherit;
  overflow:hidden;transition:transform .24s,border-color .3s,background .3s}
.pickc::after{content:"";position:absolute;inset:0;opacity:0;transition:opacity .35s;
  background:radial-gradient(240px circle at var(--px,50%) var(--py,50%),
             rgba(255,201,77,.12),transparent 62%)}
.pickc:hover{transform:translateY(-4px);border-color:var(--edge-hi);background:var(--lift2)}
.pickc:hover::after{opacity:1}
.pickc[aria-selected="true"]{border-color:var(--place);background:var(--lift2)}
.pickc .ic{font-size:26px;line-height:1;margin-bottom:9px}
.pickc h3{font-family:var(--serif);font-size:20px;font-weight:700;margin:0 0 5px}
.pickc p{font-size:13.5px;color:var(--mute);margin:0;line-height:1.5}
.pickc .tag{display:inline-block;margin-top:10px;font-size:11.5px;letter-spacing:.08em;
  padding:3px 10px;border-radius:99px;border:1px solid var(--edge)}
.tag.fam{color:var(--p2);border-color:rgba(255,158,207,.35)}
.tag.solo{color:var(--who);border-color:rgba(66,227,188,.32)}

.stage{margin-top:16px;padding:clamp(16px,3vw,28px);min-height:340px}
.shead{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;
  flex-wrap:wrap;margin:0 0 18px}
.shead h3{font-family:var(--serif);font-size:24px;margin:0 0 4px}
.shead p{margin:0;color:var(--mute);font-size:14.5px;max-width:44em}

/* ── arrowword ────────────────────────────────────────────────── */
.xwrap{overflow-x:auto;padding-bottom:6px}
.xgrid{display:grid;gap:3px;margin:0 auto;width:max-content}
.cell{width:var(--cs);height:var(--cs);border-radius:5px;background:transparent}
.cell.let{background:var(--lift2);border:1px solid var(--edge);display:flex;
  align-items:center;justify-content:center;font-family:var(--serif);
  font-size:calc(var(--cs) * .52);cursor:pointer;color:var(--text);padding:0;
  transition:border-color .15s,background .15s}
.cell.let:hover{border-color:var(--edge-hi)}
.cell.let.on{border-color:var(--place);background:rgba(255,201,77,.16)}
.cell.let.inword{background:rgba(255,201,77,.07)}
.cell.let.good{border-color:var(--who);background:rgba(66,227,188,.16)}
.cell.let.bad{border-color:var(--not);background:rgba(255,106,85,.14)}
.cell.clue{background:rgba(255,255,255,.055);border:1px solid var(--edge);
  font-size:calc(var(--cs) * .21);line-height:1.12;color:var(--mute);padding:3px;
  display:flex;flex-direction:column;justify-content:center;align-items:center;
  text-align:center;gap:1px;cursor:default;overflow:hidden}
.cell.clue .ar{color:var(--place);font-size:calc(var(--cs) * .26);line-height:1}
.xkeys{display:flex;flex-wrap:wrap;gap:5px;justify-content:center;margin:18px 0 0}
.k{font-family:var(--serif);font-size:18px;min-width:40px;padding:9px 6px;border-radius:9px;
  border:1px solid var(--edge);background:var(--lift2);color:var(--text);cursor:pointer;
  transition:all .15s}
.k:hover{border-color:var(--place);transform:translateY(-2px)}
.k.wide{min-width:66px;font-family:var(--sans);font-size:13.5px}
.xnow{text-align:center;margin:14px 0 0;font-size:15px;color:var(--mute);min-height:1.5em}
.xnow b{color:var(--place);font-family:var(--serif);font-size:1.15em}

/* ── family duel ──────────────────────────────────────────────── */
.duel{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:0 0 20px}
.pl{padding:14px 16px;border-radius:15px;border:1px solid var(--edge);background:var(--lift2);
  text-align:center;transition:border-color .25s,background .25s}
.pl.turn{border-color:var(--place);background:rgba(255,201,77,.1)}
.pl .nm{font-size:13px;color:var(--mute);margin:0 0 4px;letter-spacing:.05em}
.pl .sc{font-family:var(--serif);font-size:32px;margin:0;line-height:1}
.pl.pA .sc{color:var(--p1)} .pl.pB .sc{color:var(--p2)}
.whoseturn{text-align:center;font-size:15px;margin:0 0 18px}
.whoseturn b{font-family:var(--serif);font-size:1.2em}

/* ── shared quiz bits ─────────────────────────────────────────── */
.bar{display:flex;justify-content:space-between;align-items:center;gap:12px;
  font-size:13.5px;color:var(--mute);margin-bottom:18px;flex-wrap:wrap}
.pbar{flex:1;min-width:110px;height:6px;border-radius:99px;background:rgba(255,255,255,.08);
  overflow:hidden}
.pbar i{display:block;height:100%;border-radius:99px;width:0%;
  background:linear-gradient(90deg,var(--who),var(--place));transition:width .45s ease}
.ask{font-family:var(--serif);font-size:clamp(24px,3.6vw,42px);line-height:1.2;
  margin:0 0 6px;text-align:center}
.askhint{text-align:center;color:var(--mute);font-size:14px;margin:0 0 22px}
.choices{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.choice{font-family:var(--serif);font-size:19px;padding:17px 14px;border-radius:14px;
  border:1px solid var(--edge);background:var(--lift2);color:var(--text);cursor:pointer;
  min-height:64px;transition:border-color .18s,transform .18s}
.choice:hover:not(:disabled){border-color:var(--place);transform:translateY(-3px)}
.choice:disabled{cursor:default;opacity:.5}
.choice.right{border-color:var(--who);background:rgba(66,227,188,.16);opacity:1;animation:ding .45s ease}
.choice.wrong{border-color:var(--not);background:rgba(255,106,85,.16);opacity:1}
@keyframes ding{0%{transform:none}35%{transform:scale(1.05)}100%{transform:none}}
.verdict{margin:18px 0 0;padding:14px 16px;border-radius:14px;font-size:15px;line-height:1.58}
.verdict.ok{background:rgba(66,227,188,.10);border:1px solid rgba(66,227,188,.3)}
.verdict.no{background:rgba(255,106,85,.10);border:1px solid rgba(255,106,85,.3)}
.verdict b{font-family:var(--serif);font-size:1.13em}
.act{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px;justify-content:center}
.btn{font-family:var(--sans);font-size:15px;font-weight:500;padding:12px 23px;
  border-radius:99px;border:1px solid var(--edge-hi);background:none;color:var(--text);
  cursor:pointer;transition:all .2s}
.btn:hover{border-color:var(--place);color:var(--place)}
.btn.solid{background:var(--place);border-color:var(--place);color:#06090F;font-weight:600}
.btn.solid:hover{background:#FFD873}
.btn.fam{background:var(--p2);border-color:var(--p2);color:#1A0812;font-weight:600}
.btn.fam:hover{background:#FFB8DC}
.final{text-align:center;padding:22px 0 2px}
.final .n{font-family:var(--serif);font-size:54px;margin:0;color:var(--place);line-height:1;
  animation:rise .55s cubic-bezier(.2,.9,.25,1) both}
@keyframes rise{from{opacity:0;transform:translateY(16px) scale(.9)}to{opacity:1;transform:none}}
.final p{color:var(--mute);margin:10px 0 0}

/* ── the steps, for learning alone ────────────────────────────── */
.path{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px}
.step{position:relative;text-align:left;border:1px solid var(--edge);border-radius:15px;
  padding:14px;background:var(--lift);cursor:pointer;color:inherit;font-family:inherit;
  transition:transform .22s,border-color .28s,background .28s}
.step:hover{transform:translateY(-3px);border-color:var(--edge-hi);background:var(--lift2)}
.step[aria-selected="true"]{border-color:var(--place);background:var(--lift2)}
.step.done{border-color:rgba(66,227,188,.4)}
.step .sn{font-size:10.5px;letter-spacing:.13em;color:var(--mute);margin:0 0 6px}
.step h4{font-family:var(--serif);font-size:17px;font-weight:700;margin:0;line-height:1.25}
.tick{position:absolute;top:11px;right:11px;width:18px;height:18px;border-radius:99px;
  background:var(--who);display:none;align-items:center;justify-content:center;
  color:#06090F;font-size:11px;font-weight:700}
.step.done .tick{display:flex}
.wordlist{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px}
.wcard{padding:15px 16px;border-radius:14px;background:var(--lift2);border:1px solid var(--edge)}
.wcard .kk{font-family:var(--serif);font-size:24px;color:var(--place);line-height:1.2;margin:0 0 3px}
.wcard .ee{font-size:14px;margin:0 0 5px}
.wcard .nn{font-size:12.5px;color:var(--mute);margin:0;line-height:1.45}
.mission{display:flex;align-items:flex-start;gap:12px;max-width:40em;margin:20px auto 0;
  padding:15px 18px;border-radius:15px;background:rgba(255,158,207,.08);
  border:1px solid rgba(255,158,207,.26);text-align:left}
.mission .mi{font-size:21px;line-height:1;flex:none;margin-top:1px}
.mission .mt{font-size:15.5px;line-height:1.55}
.mission .mt b{color:var(--p2)}

/* ── ask your family ──────────────────────────────────────────── */
.gapgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(155px,1fr));gap:10px}
.gap{padding:13px 14px;border-radius:14px;border:1px dashed rgba(255,158,207,.35);
  background:rgba(255,158,207,.05);cursor:pointer;text-align:left;font-family:inherit;
  color:inherit;transition:transform .2s,border-color .25s,background .25s}
.gap:hover{transform:translateY(-3px);border-color:var(--p2);background:rgba(255,158,207,.1)}
.gap .q{font-size:14.5px;margin:0 0 4px}
.gap .a{font-family:var(--serif);font-size:18px;color:var(--p2);margin:0;min-height:1.3em}
.gap .a:empty::before{content:"tap to add what they told you";font-family:var(--sans);
  font-size:11.5px;color:var(--mute)}
.gap.filled{border-style:solid;border-color:var(--p2)}
.famcount{color:var(--p2)}

/* ── words of the week ───────────────────────────────────────────
   The gap list was a nice idea sitting still. Turning six of them into a
   weekly board gives speakers a reason to come back, and gives children
   something to chase their parents about. The six rotate on their own, the
   same six for everybody, so a family can talk about the same words.      */
.weekhead{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin:0 0 18px}
.weekno{font-family:var(--serif);font-size:13px;letter-spacing:.1em;color:var(--p2);
  padding:6px 14px;border-radius:99px;border:1px solid rgba(255,158,207,.3);
  background:rgba(255,158,207,.07)}
.weekbar{flex:1;min-width:140px;height:7px;border-radius:99px;
  background:rgba(255,255,255,.08);overflow:hidden}
.weekbar i{display:block;height:100%;border-radius:99px;width:0%;
  background:linear-gradient(90deg,var(--p2),var(--place));transition:width .5s ease}
.weekcount{font-family:var(--serif);font-size:15px;color:var(--p2)}

.wgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));gap:12px}
.wcardx{position:relative;padding:18px 17px 16px;border-radius:17px;
  border:1px dashed rgba(255,158,207,.34);background:rgba(255,158,207,.045);
  transition:transform .22s,border-color .28s,background .28s}
.wcardx:hover{transform:translateY(-3px);border-color:var(--p2);
  background:rgba(255,158,207,.09)}
.wcardx.found{border-style:solid;border-color:rgba(66,227,188,.42);
  background:rgba(66,227,188,.06)}
.wcardx .en{font-size:16.5px;margin:0 0 3px}
.wcardx .hint{font-size:12.5px;color:var(--mute);margin:0 0 12px;line-height:1.45}
.wcardx .ken{font-family:var(--serif);font-size:24px;color:var(--who);margin:0 0 10px;
  min-height:1.3em}
.wbtns{display:flex;gap:7px;flex-wrap:wrap}
.wbtns button{font-family:inherit;font-size:13px;padding:7px 13px;border-radius:99px;
  border:1px solid var(--edge);background:none;color:var(--text);cursor:pointer;
  transition:all .18s}
.wbtns button:hover{border-color:var(--p2);color:var(--p2)}
.wbtns button.go{background:var(--p2);border-color:var(--p2);color:#1A0812;font-weight:600}
.wbtns button.go:hover{background:#FFB8DC;color:#1A0812}
.wfoot{margin:20px 0 0;font-size:13.5px;color:var(--mute);line-height:1.6}

/* ── teaching Nɛpɛm, from the website ───────────────────────────
   The old version put a browser prompt() box on screen, which is ugly, has no
   room for a name, and cannot explain itself. This is a real form.            */
.tform{margin-top:14px;padding:20px;border-radius:17px;
  background:rgba(255,158,207,.055);border:1px solid rgba(255,158,207,.28)}
.tform .eyebrow{font-size:11.5px;letter-spacing:.11em;color:var(--p2);margin:0 0 8px}
.tform h4{font-family:var(--serif);font-size:20px;margin:0 0 4px}
.tform .sub{font-size:13.5px;color:var(--mute);margin:0 0 16px;line-height:1.55}
.frow{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:11px;
  margin:0 0 11px}
.fld label{display:block;font-size:12.5px;color:var(--mute);margin:0 0 5px}
.fld input,.fld textarea{width:100%;font-family:var(--sans);font-size:15px;
  padding:11px 13px;border-radius:11px;color:var(--text);
  background:rgba(255,255,255,.05);border:1px solid var(--edge);outline:none}
.fld input:focus,.fld textarea:focus{border-color:var(--p2)}
.fld input::placeholder,.fld textarea::placeholder{color:#5C6B78}
.fld textarea{min-height:76px;resize:vertical;line-height:1.5}
.fld .ken input{font-family:var(--serif);font-size:19px}
.fnote{font-size:12.5px;color:var(--mute);margin:2px 0 14px;line-height:1.5}
.fsend{display:flex;gap:9px;flex-wrap:wrap;align-items:center}
.fmsg{margin:13px 0 0;padding:12px 15px;border-radius:12px;font-size:14px;line-height:1.55}
.fmsg.ok{background:rgba(66,227,188,.1);border:1px solid rgba(66,227,188,.3)}
.fmsg.bad{background:rgba(255,106,85,.1);border:1px solid rgba(255,106,85,.3)}
.fmsg b{font-family:var(--serif);font-size:1.1em}

/* ── the two ways to help ────────────────────────────────────────
   The teach form used to be reachable only by tapping a word of the week,
   which meant a speaker who wanted to give a different word could not find
   it at all. Two plain buttons now, side by side, each opening its own form.  */
.helps{display:grid;grid-template-columns:repeat(auto-fit,minmax(265px,1fr));gap:12px;
  margin:0 0 4px}
.helpc{position:relative;text-align:left;border-radius:var(--r);padding:20px 19px;
  cursor:pointer;font-family:inherit;color:inherit;overflow:hidden;
  transition:transform .24s,border-color .3s,background .3s}
.helpc.teach{background:rgba(255,158,207,.06);border:1px solid rgba(255,158,207,.3)}
.helpc.teach:hover{background:rgba(255,158,207,.11);border-color:var(--p2)}
.helpc.wrong{background:rgba(255,106,85,.055);border:1px solid rgba(255,106,85,.28)}
.helpc.wrong:hover{background:rgba(255,106,85,.1);border-color:var(--not)}
.helpc:hover{transform:translateY(-4px)}
.helpc[aria-expanded="true"]{transform:none}
.helpc .ic{font-size:25px;line-height:1;margin-bottom:9px}
.helpc h3{font-family:var(--serif);font-size:20px;font-weight:700;margin:0 0 5px}
.helpc.teach h3{color:var(--p2)} .helpc.wrong h3{color:var(--not)}
.helpc p{font-size:13.5px;color:var(--mute);margin:0;line-height:1.52}
.helpc .arrow{position:absolute;right:18px;top:20px;font-size:15px;color:var(--mute);
  transition:transform .25s}
.helpc[aria-expanded="true"] .arrow{transform:rotate(90deg)}

/* ── the contributors' door ──────────────────────────────────────── */
.door{margin:26px 0 0;padding:17px 20px;border-radius:15px;background:var(--lift);
  border:1px solid var(--edge);display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.door .dt{flex:1;min-width:200px}
.door h4{font-family:var(--serif);font-size:17px;margin:0 0 3px}
.door p{font-size:13.5px;color:var(--mute);margin:0;line-height:1.5}
.door .lock{font-size:19px;opacity:.6;flex:none}
.doormsg{margin:14px 0 0;padding:13px 16px;border-radius:12px;font-size:14px;
  line-height:1.55;background:rgba(255,201,77,.07);
  border:1px solid rgba(255,201,77,.28);display:none}
.doormsg.show{display:block}

/* ── who has taught Nɛpɛm ──────────────────────────────────────── */
.wall{display:flex;flex-wrap:wrap;gap:9px;margin:6px 0 0}
.gave{display:inline-flex;align-items:baseline;gap:8px;padding:9px 15px;
  border-radius:99px;background:rgba(255,158,207,.07);
  border:1px solid rgba(255,158,207,.26);font-size:14.5px}
.gave .v{font-size:12px;color:var(--mute)}
.gave .n{font-family:var(--serif);font-size:12px;color:var(--p2)}
.wallnote{font-size:13.5px;color:var(--mute);margin:16px 0 0;line-height:1.6}

/* ── what is kept, and what is not ─────────────────────────────── */
.honest{display:grid;grid-template-columns:repeat(auto-fit,minmax(255px,1fr));gap:12px}
.hcard{padding:17px 18px;border-radius:16px;background:var(--lift);
  border:1px solid var(--edge)}
.hcard h4{font-family:var(--serif);font-size:17px;margin:0 0 7px}
.hcard.yes h4{color:var(--who)} .hcard.no h4{color:var(--not)}
.hcard ul{margin:0;padding-left:19px}
.hcard li{font-size:13.5px;color:var(--mute);margin:0 0 5px;line-height:1.5}

/* ── numbers ──────────────────────────────────────────────────── */
.numgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(108px,1fr));gap:9px}
.num{padding:15px 8px;min-height:92px;text-align:center;cursor:pointer;
  border:1px solid var(--edge);border-radius:14px;background:var(--lift);color:var(--text);
  font-family:inherit;transition:transform .2s,border-color .25s,background .25s}
.num:hover{transform:translateY(-4px);border-color:var(--place);background:var(--lift2)}
.num .d{display:block;font-family:var(--serif);font-size:28px;line-height:1;margin-bottom:4px}
.num .kx{display:block;font-family:var(--serif);font-size:17px;color:var(--place);line-height:1.2}
.num.on{border-color:var(--place);background:rgba(255,201,77,.13)}
.plural{margin-top:14px;padding:22px;text-align:center}
.plural .row{font-family:var(--serif);font-size:clamp(24px,3.8vw,42px);line-height:1.3;margin:0 0 8px}
.plural .row .n1{color:var(--who)} .plural .row .n2{color:var(--place)}
.plural .en{color:var(--mute);font-size:15px;margin:0}
.pchoose{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:16px}
.lvl{font-family:inherit;font-size:14.5px;padding:8px 16px;border-radius:99px;
  border:1px solid var(--edge);background:none;color:var(--mute);cursor:pointer;transition:all .2s}
.lvl:hover{color:var(--text);border-color:var(--edge-hi)}
.lvl[aria-pressed="true"]{background:var(--place);border-color:var(--place);color:#06090F;font-weight:600}

/* ── about, chat, footer ──────────────────────────────────────── */
.two{display:grid;grid-template-columns:1fr 1.25fr;gap:42px;align-items:start}
.two p{color:var(--mute);margin:0 0 14px;line-height:1.7}
.two p:last-child{margin:0}
.two b{color:var(--text);font-weight:500}
.li{display:inline-flex;align-items:center;gap:9px;text-decoration:none;margin-top:8px;
  font-size:15px;font-weight:500;padding:11px 21px;border-radius:99px;
  border:1px solid var(--edge-hi);transition:all .2s}
.li:hover{border-color:var(--place);color:var(--place);background:rgba(255,201,77,.07)}
/* ── Nɛpɛm's corner ───────────────────────────────────────────────
   He sits in the bottom corner and says hello on his own. The greeting is
   plain HTML and costs nothing, so every visitor gets it instantly. The
   Streamlit iframe behind the chat only loads when somebody actually wants
   to talk, because loading it on arrival would wake the container for people
   who never open it: slow for them, and it costs me money.                 */
.dock{position:fixed;right:clamp(14px,2.4vw,26px);bottom:clamp(14px,2.4vw,26px);
  z-index:60;display:flex;align-items:flex-end;gap:12px;flex-direction:row-reverse}
.drum{width:60px;height:60px;border-radius:50%;border:none;cursor:pointer;flex:none;
  background:linear-gradient(145deg,var(--place),#E0761F);position:relative;
  box-shadow:0 8px 30px rgba(255,201,77,.36);transition:transform .25s,box-shadow .3s}
.drum:hover{transform:translateY(-3px) scale(1.04);box-shadow:0 14px 40px rgba(255,201,77,.5)}
.drum span{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  font-family:var(--serif);font-size:27px;color:#1B1004;font-weight:700}
.drum::after{content:"";position:absolute;inset:-5px;border-radius:50%;
  border:2px solid rgba(255,201,77,.45);animation:ring 2.6s ease-out infinite}
@keyframes ring{0%{transform:scale(.9);opacity:.8}70%,100%{transform:scale(1.35);opacity:0}}
.drum.quiet::after{display:none}

.greet{max-width:min(310px,72vw);padding:15px 17px;border-radius:18px 18px 4px 18px;
  background:var(--lift2);border:1px solid var(--edge);backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);box-shadow:0 12px 40px rgba(0,0,0,.5);
  animation:greetin .45s cubic-bezier(.2,.9,.25,1) both}
@keyframes greetin{from{opacity:0;transform:translateY(12px) scale(.94)}to{opacity:1;transform:none}}
.greet .hi{font-family:var(--serif);font-size:21px;color:var(--place);margin:0 0 4px}
.greet p{font-size:13.5px;color:var(--mute);margin:0 0 11px;line-height:1.5}
.greet .sugg{display:flex;flex-direction:column;gap:6px}
.greet .sugg button{font-family:inherit;font-size:13px;text-align:left;padding:8px 12px;
  border-radius:11px;border:1px solid var(--edge);background:rgba(255,255,255,.04);
  color:var(--text);cursor:pointer;transition:all .18s}
.greet .sugg button:hover{border-color:var(--place);color:var(--place)}
.greet .shut{position:absolute;top:8px;right:10px;background:none;border:none;
  color:var(--mute);font-size:17px;cursor:pointer;line-height:1;padding:2px 4px}
.greet{position:relative}

/* the chat window itself. One element: small in the corner, or full screen. */
.pane{position:fixed;z-index:61;display:none;flex-direction:column;overflow:hidden;
  right:clamp(14px,2.4vw,26px);bottom:calc(clamp(14px,2.4vw,26px) + 74px);
  width:min(400px,calc(100vw - 28px));height:min(560px,calc(100vh - 130px));
  border-radius:20px;border:1px solid var(--edge);background:#080C13;
  box-shadow:0 22px 70px rgba(0,0,0,.6);
  animation:panein .3s cubic-bezier(.2,.9,.25,1) both}
@keyframes panein{from{opacity:0;transform:translateY(18px) scale(.97)}to{opacity:1;transform:none}}
.pane.open{display:flex}
.pane.big{right:clamp(10px,2vw,24px);left:clamp(10px,2vw,24px);
  top:clamp(10px,2vw,24px);bottom:clamp(10px,2vw,24px);
  width:auto;height:auto;border-radius:22px}
.phead{display:flex;align-items:center;justify-content:space-between;gap:10px;
  padding:12px 14px;border-bottom:1px solid var(--edge);background:var(--lift);flex:none}
.phead .who{display:flex;align-items:center;gap:10px;min-width:0}
.phead .av{width:32px;height:32px;border-radius:50%;flex:none;
  background:linear-gradient(145deg,var(--place),#E0761F);display:flex;
  align-items:center;justify-content:center;font-family:var(--serif);
  font-size:15px;color:#1B1004;font-weight:700}
.phead h3{font-family:var(--serif);font-size:17px;margin:0;line-height:1.2}
.phead .st{font-size:11.5px;color:var(--who);margin:0;display:flex;align-items:center;gap:5px}
.phead .st i{width:6px;height:6px;border-radius:99px;background:var(--who);display:inline-block}
.pbtns{display:flex;gap:4px;flex:none}
.pbtns button, .pbtns a{background:none;border:1px solid transparent;color:var(--mute);
  cursor:pointer;border-radius:9px;padding:6px 9px;font-size:14px;line-height:1;
  font-family:inherit;text-decoration:none;transition:all .18s}
.pbtns button:hover,.pbtns a:hover{color:var(--place);border-color:var(--edge)}
.pbody{flex:1;position:relative;min-height:0;background:#080C13}
.pbody iframe{width:100%;height:100%;border:none;display:block}
.waking{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;
  justify-content:center;gap:12px;text-align:center;padding:22px;color:var(--mute);font-size:14px}
.spin{width:28px;height:28px;border-radius:99px;border:2px solid rgba(255,201,77,.25);
  border-top-color:var(--place);animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

footer{border-top:1px solid var(--edge);padding:26px 0 50px;display:flex;
  justify-content:space-between;gap:20px;flex-wrap:wrap;font-size:14px;color:var(--mute)}
footer p{margin:0}
.flinks{display:flex;gap:4px;flex-wrap:wrap}
.flinks a{text-decoration:none;padding:6px 12px;border-radius:99px;transition:all .2s}
.flinks a:hover{color:var(--place);background:rgba(255,201,77,.07)}

@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *{transition-duration:.01ms !important;animation-duration:.01ms !important}
  #field,.aura{display:none} .sky{opacity:.32} .blob{animation:none !important}
}
@media (hover:none){ .pickc::after{display:none} }
@media (max-width:880px){
  .two{grid-template-columns:1fr;gap:18px}
  .sec{padding:30px 0} nav{padding:12px 0} .brand small{display:none}
  .sky{filter:blur(70px)}
}
</style>
</head>
<body>
<div class="sky" aria-hidden="true">
  <div class="blob b1"></div><div class="blob b2"></div>
  <div class="blob b3"></div><div class="blob b4"></div>
</div>
<canvas id="field" aria-hidden="true"></canvas>
<div class="aura" aria-hidden="true"></div>

<div class="wrap">
  <nav>
    <span class="brand">Nɛpɛm<small>KƐ́NYĀŊ · THE LANGUAGE OF HOME</small></span>
    <div class="nav-r">
      <a class="q" href="#table">Play together</a>
      <a class="q" href="#alone">Learn on your own</a>
      <a class="q" href="#family">Ask your family</a>
      <button class="cta" id="openChat"><span class="dot"></span>Ask Nɛpɛm</button>
    </div>
  </nav>

  <!-- ══ THE BUILDER, FIRST THING ON THE PAGE ═════════════════════════
       Adults want this as much as children do. Many diaspora parents
       understand Kenyang and cannot produce it, and have never once seen
       the rule written down. So it goes at the top, not tucked away.     -->
  <section class="hero" aria-labelledby="heroT">
    <h1 class="sr" id="heroT">How a Kenyang sentence is built</h1>
    <p class="hlead"><b>A Kenyang sentence is built from parts, in a fixed order.</b>
      Change who, when, whether it happened, or where, and watch it rebuild. If you
      grew up hearing this language but never learned to say it, start here.</p>

    <p class="built" id="built" aria-live="polite"></p>
    <p class="gloss" id="gloss"></p>

    <div class="controls">
      <div class="ctl glass c-who"><p class="ctl-label"><span class="swatch"></span>WHO</p>
        <div class="opts" id="cWho" role="group" aria-label="Who"></div></div>
      <div class="ctl glass c-verb"><p class="ctl-label"><span class="swatch"></span>DOING WHAT</p>
        <div class="opts" id="cVerb" role="group" aria-label="Verb"></div></div>
      <div class="ctl glass c-when"><p class="ctl-label"><span class="swatch"></span>WHEN</p>
        <div class="opts" id="cWhen" role="group" aria-label="When"></div></div>
      <div class="ctl glass c-not"><p class="ctl-label"><span class="swatch"></span>DID IT HAPPEN</p>
        <div class="opts" id="cNot" role="group" aria-label="Negation"></div></div>
      <div class="ctl glass c-place"><p class="ctl-label"><span class="swatch"></span>WHERE</p>
        <div class="opts" id="cPlace" role="group" aria-label="Where"></div></div>
    </div>

    <p class="recipe">The order never changes: <code id="recipe"></code></p>
    <div class="legend" aria-hidden="true">
      <span><i style="background:var(--who)"></i>who</span>
      <span><i style="background:var(--not)"></i>not</span>
      <span><i style="background:var(--root)"></i>the verb</span>
      <span><i style="background:var(--when)"></i>when</span>
      <span><i style="background:var(--place)"></i>where</span>
    </div>
  </section>

  <hr class="rule">

  <!-- ══ THINGS TO DO WITH SOMEBODY ══════════════════════════════════ -->
  <section class="sec" id="table">
    <h2 class="big">Sit down with somebody. <em>These two are better with a second
      person.</em></h2>
    <p class="lead">A crossword nobody in the world has been able to do before, and a
      duel you can lose to your eight year old. Both work on one screen between two
      people.</p>

    <div class="picks" id="picks" role="tablist" aria-label="Choose an activity"></div>
    <div class="stage glass" id="stage" role="tabpanel" aria-live="polite"></div>
  </section>

  <hr class="rule">

  <!-- ══ LEARNING ALONE ══════════════════════════════════════════════ -->
  <section class="sec" id="alone">
    <h2 class="big">Eight steps, when you have five minutes on your own.</h2>
    <p class="lead">Each one ends with something to go and say to a person. That last
      part is the point, whether you are nine or thirty nine.</p>
    <div class="path" id="pathGrid" role="tablist" aria-label="Steps"></div>
    <div class="stage glass" id="lesson" role="tabpanel" aria-live="polite"></div>
  </section>

  <hr class="rule">

  <!-- ══ ASK YOUR FAMILY ═════════════════════════════════════════════ -->
  <section class="sec" id="family">
    <h2 class="big">Six words Nɛpɛm does not know. <em>This week.</em></h2>
    <p class="lead">Nobody has written these down, so Nɛpɛm cannot help with them
      yet. Anyone who speaks Kenyang can fix that in about ten seconds. Six new
      ones appear every Monday.</p>

    <div class="weekhead">
      <span class="weekno" id="weekno"></span>
      <span class="weekbar"><i id="weekbar"></i></span>
      <span class="weekcount" id="weekcount"></span>
    </div>

    <div class="wgrid" id="wgrid"></div>

    <p class="wfoot">If you do not know these, that is the point. Go and ask
      somebody who does, then come back and write it in. That is how a language
      gets written down for the next person.</p>
  </section>

  <hr class="rule">

  <!-- ══ THE TWO WAYS TO HELP ═════════════════════════════════════════
       Both forms start closed and each has its own button. Before this the
       teach form could only be reached by tapping a word of the week, so a
       speaker who wanted to give some other word had nowhere to put it.   -->
  <section class="sec" id="help">
    <h2 class="big">Nɛpɛm is built from old books and one speaker's checking.
      <em>Anyone who knows the language can make him better.</em></h2>
    <p class="lead">Two things are worth sending. A word he does not have, and
      an answer he got wrong. The second is rarer and more valuable.</p>

    <div class="helps">
      <button class="helpc teach" id="btnTeach" aria-expanded="false"
              aria-controls="tform">
        <span class="arrow" aria-hidden="true">›</span>
        <div class="ic" aria-hidden="true">🌿</div>
        <h3>Teach Nɛpɛm a word</h3>
        <p>Any Kenyang word or phrase he does not know yet. A word with a sentence
          around it is worth far more than the word alone.</p>
      </button>
      <button class="helpc wrong" id="btnWrong" aria-expanded="false"
              aria-controls="rform">
        <span class="arrow" aria-hidden="true">›</span>
        <div class="ic" aria-hidden="true">✎</div>
        <h3>Nɛpɛm got something wrong</h3>
        <p>He invents things when he does not know, and he has been corrected
          before. Say what he should have said, and why.</p>
      </button>
    </div>

    <!-- teach ------------------------------------------------------------ -->
    <div class="tform" id="tform" style="display:none">
      <p class="eyebrow" id="tfEyebrow">TEACH NƐPƐM A WORD</p>
      <h4 id="tfTitle">What is the Kenyang for this?</h4>
      <p class="sub">Write it the way it is said. Spelling gets tidied later;
        getting it written down at all is the hard part.</p>

      <div class="frow">
        <div class="fld"><label for="tfEn">The English</label>
          <input id="tfEn" placeholder="tomorrow" autocomplete="off"></div>
        <div class="fld ken"><label for="tfKen">The Kenyang</label>
          <input id="tfKen" placeholder="type it as you say it" autocomplete="off"></div>
      </div>

      <div class="fld"><label for="tfNote">Use it in a sentence, if you can</label>
        <textarea id="tfNote" placeholder="mbuere mme rong ekere-wah, meaning tomorrow I am going to my house"></textarea></div>
      <p class="fnote">A sentence is worth far more than the word on its own. It
        shows where the word sits and what changes around it.</p>

      <div class="frow">
        <div class="fld"><label for="tfWho">Your name, so you can be credited</label>
          <input id="tfWho" placeholder="leave it blank to stay unnamed" autocomplete="name"></div>
        <div class="fld"><label for="tfVil">Your village</label>
          <input id="tfVil" placeholder="Bachou Ntai, Mamfe, anywhere" autocomplete="off"></div>
      </div>

      <div class="fsend">
        <button class="btn fam" id="tfSend">Send it</button>
        <button class="btn" id="tfCancel">Not now</button>
      </div>
      <div id="tfMsg"></div>
    </div>

    <!-- report ----------------------------------------------------------- -->
    <div class="tform" id="rform" style="display:none;
         border-color:rgba(255,106,85,.3);background:rgba(255,106,85,.05)">
      <p class="eyebrow" style="color:var(--not)">TELL NƐPƐM HE IS WRONG</p>
      <h4>What did he get wrong?</h4>
      <p class="sub">Nothing sent here changes what Nɛpɛm teaches until a speaker
        has read it. That gate is deliberate.</p>

      <div class="fld"><label for="rfQ">What did you ask him?</label>
        <input id="rfQ" placeholder="how do you say tell them I am going to church"
               autocomplete="off"></div>
      <div class="fld"><label for="rfA">What did he answer?</label>
        <textarea id="rfA" placeholder="paste or type what he said"></textarea></div>
      <div class="fld ken"><label for="rfK">What should he have said?</label>
        <input id="rfK" placeholder="ghati bho bɛ mme rong ekeré-Mandɛm"
               autocomplete="off"></div>
      <div class="fld"><label for="rfN">Why is his version wrong?</label>
        <textarea id="rfN" placeholder="angati is only for passing a message through somebody else. One telling needs just ghati."></textarea></div>
      <p class="fnote">The reason matters more than the correction. One explained
        reason fixes a whole family of sentences; a bare correction fixes one.</p>

      <div class="frow">
        <div class="fld"><label for="rfWho">Your name, so you can be credited</label>
          <input id="rfWho" placeholder="leave it blank to stay unnamed" autocomplete="name"></div>
        <div class="fld"><label for="rfVil">Your village</label>
          <input id="rfVil" placeholder="Bachou Ntai, Mamfe, anywhere" autocomplete="off"></div>
      </div>

      <div class="fsend">
        <button class="btn" id="rfSend" style="background:var(--not);
          border-color:var(--not);color:#1A0805;font-weight:600">Send the correction</button>
        <button class="btn" id="rfCancel">Not now</button>
      </div>
      <div id="rfMsg"></div>
    </div>
  </section>

  <hr class="rule">

  <!-- ══ WHO HAS TAUGHT HIM, AND THE DOOR FOR CONTRIBUTORS ═══════════ -->
  <section class="sec" id="wall">
    <h2 class="big">Who has taught Nɛpɛm so far</h2>
    <p class="lead">Every word he knows came from a person. These are the people
      who gave one.</p>
    <div class="wall" id="wallList"></div>
    <p class="wallnote" id="wallNote"></p>

    <div class="door">
      <span class="lock" aria-hidden="true">🔒</span>
      <div class="dt">
        <h4>Reviewing what has come in</h4>
        <p>Submissions are read by a verified contributor before Nɛpɛm learns
          anything. If that is you, this is the way in.</p>
      </div>
      <button class="btn" id="doorBtn">Review submissions</button>
    </div>
    <div class="doormsg" id="doorMsg"></div>
  </section>

  <hr class="rule">

  <!-- ══ WHAT IS KEPT ════════════════════════════════════════════════
       Plain, specific, and near the forms rather than buried in a policy
       page. A project whose whole argument is that it does not do things
       behind people's backs has to say what it does.                      -->
  <section class="sec" id="honest">
    <h2 class="big">What Nɛpɛm keeps, and what he does not</h2>
    <p class="lead">This project exists because AI was careless with a language.
      Being careless with the people teaching it would be the same mistake.</p>

    <div class="honest">
      <div class="hcard yes">
        <h4>Kept</h4>
        <ul>
          <li>Words and corrections sent through the forms above</li>
          <li>The name and village given with them, if any were given</li>
          <li>The date it was sent</li>
        </ul>
      </div>
      <div class="hcard no">
        <h4>Not kept</h4>
        <ul>
          <li>Conversations with Nɛpɛm. What is typed in the chat is not stored</li>
          <li>Any account, email address, or login. There are none</li>
          <li>Anything at all from the games. They run in the browser and send nothing</li>
        </ul>
      </div>
      <div class="hcard">
        <h4>What happens to it</h4>
        <ul>
          <li>A native speaker reads every submission before Nɛpɛm learns it</li>
          <li>Approved words go into the material he teaches from, credited</li>
          <li>Nothing is passed to anybody outside the project</li>
          <li>To have a submission removed, write to
            <a href="mailto:agboredouard51@gmail.com"
               style="color:var(--place)">agboredouard51@gmail.com</a></li>
        </ul>
      </div>
    </div>
    <p class="wallnote">Nɛpɛm is not trained on what people send. There is no
      learning that happens on its own. A speaker confirms a word, writes it into
      the material by hand, and only then can Nɛpɛm say it. That is slower than
      an AI that teaches itself, and it is the reason this one can be trusted with
      a child.</p>
  </section>

  <hr class="rule">

  <!-- ══ NUMBERS ═════════════════════════════════════════════════════ -->
  <section class="sec" id="numbers">
    <h2 class="big">Count to ten, and watch a word change when there is
      <b>more than one</b>.</h2>
    <p class="lead">Pick a thing and how many. The number comes after the thing, and
      the thing itself changes shape. This is the part that surprises people who
      thought they already knew the language.</p>
    <div class="numgrid" id="numgrid" role="group" aria-label="Numbers one to ten"></div>
    <div class="plural glass">
      <p class="row" id="plRow"></p>
      <p class="en" id="plEn"></p>
      <div class="pchoose" id="plThings" role="group" aria-label="Pick a thing"></div>
      <div class="pchoose" id="plCounts" role="group" aria-label="Pick how many"></div>
    </div>
  </section>

  <hr class="rule">

  <section class="sec" id="about">
    <div class="two">
      <h2 class="big" style="margin:0">Who made this, and why</h2>
      <div>
        <p>I am <b>Agbor Edouard Ransome</b>, from Bachou Ntai in the Manyu Division of
          Cameroon. Kenyang is my mother tongue.</p>
        <p>I study <b>Applied Human-Centered AI</b> at Syracuse University and I build AI
          for people the technology usually skips. I founded <b>GritGateway</b>, which
          connects African students to universities and scholarships. I have been a
          Chevening Scholar and a Mandela Washington Fellow.</p>
        <p>I built this because a machine that speaks a hundred languages had never heard
          mine. I recovered Kenyang from old dictionaries and grammars no computer could
          read, then checked every word and every rule myself. <b>A tool that invents your
          language is worse than no tool at all.</b></p>
        <p>What I actually want is a father and a child arguing over a crossword clue in
          Kenyang, and one of them going to ask the grandmother who is right.</p>
        <a class="li" href="https://www.linkedin.com/in/agbor-edouard-ransome-52a755150/"
           target="_blank" rel="noopener">Connect on LinkedIn →</a>
      </div>
    </div>
  </section>

  <hr class="rule">

  <section class="sec">
    <div class="two">
      <h2 class="big" style="margin:0">It will not invent your language</h2>
      <div>
        <p>Ask a general purpose AI for Kenyang and it answers confidently and wrongly,
          because it has never seen the language. For anyone learning, that is worse than
          no answer. The invented words get learned as real ones.</p>
        <p>Everything here comes from Kenyang recovered from old sources and then confirmed
          by a native speaker. <b>When Nɛpɛm does not know something, it says so.</b> That
          is why there is a whole section above of words it cannot help you with yet.</p>
        <p>Kenyang is spoken by about 65,000 people in the Southwest Region of Cameroon.
          It has never had an app, a course, or a crossword. This is the first.</p>
      </div>
    </div>
  </section>

  <footer>
    <p>Built by Agbor Edouard Ransome, of Bachou Ntai, Manyu Division.</p>
    <div class="flinks">
      <a href="#table">Play together</a>
      <a href="#about">About</a>
      <a href="mailto:agboredouard51@gmail.com">agboredouard51@gmail.com</a>
    </div>
  </footer>
</div>

<!-- ══ NƐPƐM'S CORNER ═══════════════════════════════════════════════
     He greets you himself when the page opens. The greeting is plain HTML,
     so it is instant and free. The chat behind it only loads when somebody
     taps, which keeps the Streamlit container asleep for the many visitors
     who never open it.                                                      -->
<div class="dock">
  <button class="drum" id="drum" aria-label="Talk to Nɛpɛm"><span>N</span></button>
  <div class="greet" id="greet" role="status">
    <button class="shut" id="greetShut" aria-label="Hide">&times;</button>
    <p class="hi">Mba'aaah!</p>
    <p>I am Nɛpɛm. I only speak Kenyang that a real speaker has checked, and I
      say so when I do not know something.</p>
    <div class="sugg">
      <button data-ask>How do I greet my mother?</button>
      <button data-ask>What does <em>bá pú rong nyaka</em> mean?</button>
      <button data-ask>Just let me type</button>
    </div>
  </div>
</div>

<div class="pane" id="pane" role="dialog" aria-modal="false" aria-labelledby="paneT">
  <div class="phead">
    <div class="who">
      <span class="av" aria-hidden="true">N</span>
      <div style="min-width:0">
        <h3 id="paneT">Nɛpɛm</h3>
        <p class="st"><i aria-hidden="true"></i><span id="pstat">here with you</span></p>
      </div>
    </div>
    <div class="pbtns">
      <button id="paneBig" title="Make it bigger" aria-label="Make it bigger">&#9713;</button>
      <a id="newTab" href="https://kenyanglanguage.streamlit.app" target="_blank"
         rel="noopener" title="Open in a new tab" aria-label="Open in a new tab">&#8599;</a>
      <button id="paneShut" title="Close" aria-label="Close">&times;</button>
    </div>
  </div>
  <div class="pbody" id="chatBody">
    <div class="waking" id="waking"><div class="spin"></div>
      <p style="margin:0">Waking up. He sleeps when nobody is talking to him,<br>
        so the first few seconds are slow.</p></div>
  </div>
</div>

<script>
/* ═══════════════════════════════════════════════════════════════════════════
   1 · THE DATA. Every word below has been confirmed by a native speaker.
   ═══════════════════════════════════════════════════════════════════════════ */

/* Two verbs, and only two. Both are confirmed by a speaker in the full pattern
   (mme rong, mme pú rong, mme rong nyaka, a'tuor) and both take a place after
   them. dɔ́k was here briefly and came out glossed "going" as well, which made
   two buttons produce the same English. It belongs with Sé dok (let us go),
   which is a different shape, so it is out until that is worked through. */
const VERBS = [{ken:"rong", en:"going"}, {ken:"tuor", en:"coming"}];
const WHO = [
  {ken:"mme", en:"I", be:["am","was"]},  {ken:"O'", en:"you", be:["are","were"]},
  {ken:"à", en:"he", be:["is","was"]},   {ken:"sé", en:"we", be:["are","were"]},
  {ken:"bá", en:"they", be:["are","were"]}
];
const WHEN  = [{ken:null,en:"now"},{ken:"nyaka",en:"before"}];
const NOTQ  = [{on:false,en:"it did"},{on:true,en:"it did not"}];
const PLACE = [{ken:null,en:"nowhere"},{ken:"ɛkɛt",en:"home"},
  {ken:"ekeré-ékáti",en:"to school"},{ken:"ekeré-Mandɛm",en:"to church"},
  {ken:"amem",en:"inside"},{ken:"nefi",en:"outside"}];

const NUMBERS = [["1","ɛ́mɔt"],["2","bɛ́pay"],["3","bɛ́rát"],["4","mɛ́nwi"],["5","bɛ́tay"],
  ["6","bɛ́tandat"],["7","tándrámɔt"],["8","mɛ́nɛn"],["9","mɛ́nɛn nɛ amɔt"],["10","byó"]];

/* Only the plural pairs a speaker has confirmed. The shape changes per noun, so
   guessing one would be exactly the mistake this project exists to avoid. */
const PLURALS = [
  {one:"ɛkɛt", many:"beket", en1:"house", en2:"houses"},
  {one:"ékwá", many:"békwá", en1:"plantain", en2:"plantains"}
];

/* The crossword. Laid out and verified by a generator, not by hand, then
   embedded here so the browser never has to solve anything. Tone marks are
   dropped for the grid because a crossword needs one letter per square, but
   Kenyang's own letters stay: Ɛ Ɔ Ŋ are themselves, not E O N. The fully
   written form appears when a word is solved. */
const XW = {"w":13,"h":9,"words":[
 {"g":"NNEK","w":"nnek","clue":"please","r":2,"c":5,"cr":2,"cc":4,"down":false},
 {"g":"ƐKATI","w":"ɛkáti","clue":"book","r":1,"c":8,"cr":0,"cc":8,"down":true},
 {"g":"NKAGHA","w":"nkagha","clue":"thank you","r":2,"c":5,"cr":1,"cc":5,"down":true},
 {"g":"MMA","w":"mmá","clue":"mother","r":4,"c":3,"cr":4,"cc":2,"down":false},
 {"g":"MMOK","w":"mmok","clue":"sun","r":4,"c":3,"cr":3,"cc":3,"down":true},
 {"g":"SIRI","w":"siri","clue":"well, fine","r":5,"c":7,"cr":5,"cc":6,"down":false},
 {"g":"ƐKWA","w":"ékwá","clue":"plantain","r":7,"c":2,"cr":7,"cc":1,"down":false},
 {"g":"NEFI","w":"nefi","clue":"outside","r":2,"c":10,"cr":1,"cc":10,"down":true},
 {"g":"AMEM","w":"amem","clue":"inside","r":3,"c":8,"cr":3,"cc":7,"down":false},
 {"g":"REM","w":"Rem","clue":"speak","r":5,"c":1,"cr":5,"cc":0,"down":false},
 {"g":"MANOR","w":"manor","clue":"brother or sister","r":1,"c":1,"cr":0,"cc":1,"down":true},
 {"g":"RONG","w":"rong","clue":"going","r":5,"c":9,"cr":4,"cc":9,"down":true},
 {"g":"MOH","w":"moh","clue":"son or daughter","r":1,"c":1,"cr":1,"cc":0,"down":false},
 {"g":"NEYI","w":"néyi","clue":"good morning","r":7,"c":9,"cr":7,"cc":8,"down":false}
]};

/* the Kenyang alphabet, for the crossword keyboard. Typing Ɛ teaches the
   alphabet, which is half the reason the crossword is worth having. */
const KEYS = ["A","B","CH","D","E","Ɛ","F","G","GH","I","Ɨ","J","K","L","M",
              "N","NY","Ŋ","O","Ɔ","P","R","S","T","U","Ʉ","W","Y"];

const STEPS = [
{id:"hello", n:"Step 1", title:"Say hello",
 sub:"Two words you can use before breakfast tomorrow.",
 words:[["Mba'aaah","hello","Say it warmly and stretch it out. It works for anyone."],
        ["néyi","good morning","The first thing you say when you wake up."]],
 mission:"Tomorrow morning, before one word of English, say <b>néyi</b> to whoever you see first."},
{id:"answer", n:"Step 2", title:"Answer properly",
 sub:"In Bayangi homes, yes has more than one shape.",
 words:[["Máah","yes, Mom","Only for your mother. It carries respect with it."],
        ["Sáah","yes, Dad","For your father, or any elder."],
        ["Èh!","yes","The plain yes, for anyone."],
        ["Éh Èh!","no","Careful. Èh alone is yes. Doubled, it becomes no."]],
 mission:"Next time your mother calls your name, answer <b>Máah</b>. Do not explain first."},
{id:"howare", n:"Step 3", title:"Ask if someone is well",
 sub:"A whole conversation, both halves of it.",
 words:[["Mma O'chi siri?","Mother, are you well?","O' is the mark for you."],
        ["Éh, M'chi siri","yes, I am well","M' is the mark for I. Same shape, other person."],
        ["M'pu siri","I am not well","pu is the little word that turns it around."]],
 mission:"Ask somebody at home <b>Mma O'chi siri?</b> and see whether they can answer."},
{id:"polite", n:"Step 4", title:"Please and thank you",
 sub:"The words that make people want to keep talking to you.",
 words:[["nnek","please","Put it in front of what you are asking for."],
        ["nkagha","thank you","The plain thank you."],
        ["Oki ah","thank you","It really means you have done it."]],
 mission:"Say <b>nkagha</b> next time somebody puts food in front of you. Then ask which one they would say."},
{id:"family", n:"Step 5", title:"Everyone at home",
 sub:"The people you see every day, in their own names.",
 words:[["mmá","mother","Also used warmly for a small child."],["étá","father",""],
        ["mmɔ","child",""],["manor","brother or sister","One word for both."],
        ["Nereket","family",""],["Nchemty","family, togetherness","Bigger than it looks."]],
 mission:"Point at each person at home and say their Kenyang name. Then ask who else belongs on the list."},
{id:"count", n:"Step 6", title:"Count to five",
 sub:"Then count real things, not numbers on a screen.",
 words:[["ɛ́mɔt","one",""],["bɛ́pay","two",""],["bɛ́rát","three",""],
        ["mɛ́nwi","four",""],["bɛ́tay","five",""]],
 mission:"Count five things in your kitchen out loud. Get somebody to check you."},
{id:"need", n:"Step 7", title:"Say what you need",
 sub:"The three things everybody says most often.",
 words:[["Nsai ah nu meh","I am hungry","This one has its own shape. Learn it whole."],
        ["M'pop","I am tired",""],["Che mme","give me","Put what you want after it."],
        ["Meh yan","I want","Really it means I am looking for."]],
 mission:"Next time you are hungry, say <b>Nsai ah nu meh</b> before the English."},
{id:"first", n:"Step 8", title:"Your first sentence",
 sub:"Now you stop learning words and start building.",
 words:[["mme rong","I am going",""],["bá rong","they are going","One piece changed."],
        ["mme pú rong","I am not going","pú goes in the middle."],
        ["mme rong nyaka","I was going","nyaka at the end puts it in the past."],
        ["mme rong ɛkɛt","I am going home","Where you are going comes last."]],
 mission:"Tell somebody where you are going today in Kenyang before you leave the room."}
];

/* The words nobody has confirmed yet. Six of these go up each week, chosen by
   the week number so every family sees the same six and can talk about them.
   The hint matters: "red" on its own is ambiguous, and a speaker who is not
   sure what is being asked will not answer at all. */
const GAPS = [
  ["tomorrow","the day after today"],
  ["yesterday","the day before today"],
  ["goodbye","when somebody is leaving"],
  ["good night","the last thing you say before bed"],
  ["I am sorry","when you have done something wrong"],
  ["I love you","to a person, not a thing"],
  ["red","the colour"],
  ["green","the colour"],
  ["blue","the colour"],
  ["bird","any bird"],
  ["fish","the animal, in water"],
  ["tree","a big one, growing"],
  ["happy","how you feel on a good day"],
  ["sad","how you feel on a bad one"],
  ["rain","the thing that falls"],
  ["road","the one you walk on"],
  ["friend","somebody you choose"],
  ["song","one you would sing"],
  ["market","where things are sold"],
  ["night","when it is dark"],
  ["morning","early, when you wake"],
  ["food","anything you eat"],
  ["money","what you buy with"],
  ["name","what you are called"],
  ["work","what grown ups go and do"],
  ["sleep","what you do at night"],
  ["run","fast, on your legs"],
  ["sit","on a chair or the ground"],
  ["cold","how water feels in the morning"],
  ["hot","how the sun feels"]
];

const $ = id => document.getElementById(id);
const shuffle = a => a.map(v=>[Math.random(),v]).sort((x,y)=>x[0]-y[0]).map(v=>v[1]);
const pick = a => a[Math.floor(Math.random()*a.length)];
const esc = s => String(s).replace(/[&<>"]/g,
  c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));

const KEY="nepem.v4";
function load(){ try{ return JSON.parse(localStorage.getItem(KEY))||{}; }catch(e){ return {}; } }
function save(){ try{ localStorage.setItem(KEY, JSON.stringify(S)); }catch(e){} }
let S = Object.assign({done:{}, fam:{}, names:["Grown up","Child"]}, load());

/* ═══════════════════════════════════════════════════════════════════════════
   2 · THE BUILDER
   Nothing is written out in advance. Each sentence is assembled from the
   confirmed rule: person + pú (not) + verb + nyaka (past) + place.
   ═══════════════════════════════════════════════════════════════════════════ */
let E = {who:0, verb:0, when:0, not:0, place:0};
function chip(parent,label,group,i,on){
  const b=document.createElement("button");
  b.className="opt"; b.type="button"; b.textContent=label;
  b.setAttribute("aria-pressed", on?"true":"false");
  b.addEventListener("click",()=>{E[group]=i; paint(group);});
  parent.appendChild(b);
}
function chips(){
  ["cWho","cVerb","cWhen","cNot","cPlace"].forEach(id=>$(id).textContent="");
  WHO.forEach((o,i)=>chip($("cWho"),o.ken,"who",i,E.who===i));
  VERBS.forEach((o,i)=>chip($("cVerb"),o.ken,"verb",i,E.verb===i));
  WHEN.forEach((o,i)=>chip($("cWhen"),o.en,"when",i,E.when===i));
  NOTQ.forEach((o,i)=>chip($("cNot"),o.en,"not",i,E.not===i));
  PLACE.forEach((o,i)=>chip($("cPlace"),o.en,"place",i,E.place===i));
}
function paint(changed){
  const who=WHO[E.who], verb=VERBS[E.verb], when=WHEN[E.when],
        neg=NOTQ[E.not].on, place=PLACE[E.place];
  const parts=[{t:who.ken,r:"who"}];
  if(neg) parts.push({t:"pú",r:"not"});
  parts.push({t:verb.ken,r:"root"});
  if(when.ken) parts.push({t:when.ken,r:"when"});
  if(place.ken) parts.push({t:place.ken,r:"place"});
  const out=$("built"); out.textContent="";
  parts.forEach(p=>{
    const el=document.createElement("span");
    el.className="m m-"+p.r; el.textContent=p.t;
    if(changed===undefined||changed===p.r||(changed==="verb"&&p.r==="root")) el.classList.add("in");
    out.appendChild(el);
  });
  $("gloss").innerHTML=`<b class="g-who">${who.en}</b> ${who.be[E.when]}`
    +(neg?` <b class="g-not">not</b>`:"")+` ${verb.en}`
    +(place.ken?` ${place.en}`:"");
  $("recipe").textContent="who"+(neg?"  +  not":"")+"  +  "+verb.ken
    +(when.ken?"  +  past":"")+(place.ken?"  +  where":"");
  [["c-who","who"],["c-verb","verb"],["c-when","when"],["c-not","not"],["c-place","place"]]
    .forEach(([cls,g])=>[...document.querySelector("."+cls).querySelectorAll(".opt")]
      .forEach((b,i)=>b.setAttribute("aria-pressed",E[g]===i?"true":"false")));
}
chips(); paint();

/* ═══════════════════════════════════════════════════════════════════════════
   3 · THINGS TO DO WITH SOMEBODY
   ═══════════════════════════════════════════════════════════════════════════ */
const PICKS = [
  {id:"xw",   ic:"🧩", t:"Kenyang crossword", tag:"fam",
   d:"Ten words, clues in English, arrows showing the way. Argue about it."},
  {id:"duel", ic:"⚔️", t:"Family duel", tag:"fam",
   d:"Two players, one screen. Take turns. Children usually win."},
  {id:"build",ic:"🔤", t:"Build the sentence", tag:"solo",
   d:"You get the English. Put the Kenyang words in the right order."}
];
let A = {id:"xw"};
const stage = $("stage");

function paintPicks(){
  $("picks").innerHTML = PICKS.map(p=>`
    <button class="pickc" data-pick="${p.id}" role="tab" aria-selected="${A.id===p.id}">
      <div class="ic" aria-hidden="true">${p.ic}</div>
      <h3>${p.t}</h3><p>${p.d}</p>
      <span class="tag ${p.tag}">${p.tag==="fam"?"BETTER WITH TWO":"ON YOUR OWN"}</span>
    </button>`).join("");
  document.querySelectorAll(".pickc").forEach(c=>{
    c.addEventListener("click",()=>{A.id=c.dataset.pick; runActivity();});
    c.addEventListener("pointermove",e=>{
      const r=c.getBoundingClientRect();
      c.style.setProperty("--px",(e.clientX-r.left)+"px");
      c.style.setProperty("--py",(e.clientY-r.top)+"px");
    },{passive:true});
  });
}

/* ── the crossword ───────────────────────────────────────────── */
let X = null;
function xInit(){
  const letters = {};                       /* key "r,c" -> the right letter */
  const clues = {};
  XW.words.forEach(w=>{
    for(let i=0;i<w.g.length;i++){
      const r = w.down ? w.r+i : w.r, c = w.down ? w.c : w.c+i;
      letters[r+","+c] = w.g[i];
    }
    clues[w.cr+","+w.cc] = w;
  });
  X = {letters, clues, filled:{}, sel:null, dir:"across", checked:false};
}
function xCells(){
  const out=[];
  for(let r=0;r<XW.h;r++) for(let c=0;c<XW.w;c++){
    const k=r+","+c;
    if(X.clues[k]){
      const w=X.clues[k];
      out.push(`<div class="cell clue"><span>${esc(w.clue)}</span>
        <span class="ar" aria-hidden="true">${w.down?"↓":"→"}</span></div>`);
    } else if(X.letters[k]){
      const v = X.filled[k] || "";
      let cls = "cell let";
      if(X.sel===k) cls+=" on";
      else if(xInSelWord(r,c)) cls+=" inword";
      if(X.checked && v) cls += (v===X.letters[k] ? " good" : " bad");
      out.push(`<button class="${cls}" data-cell="${k}">${esc(v)}</button>`);
    } else {
      out.push(`<div class="cell"></div>`);
    }
  }
  return out.join("");
}
function xInSelWord(r,c){
  if(!X.sel) return false;
  const [sr,sc]=X.sel.split(",").map(Number);
  return X.dir==="across" ? (r===sr && xSameRun(sr,sc,r,c,false))
                          : (c===sc && xSameRun(sr,sc,r,c,true));
}
function xSameRun(sr,sc,r,c,down){
  const w = XW.words.find(w=>{
    if(w.down!==down) return false;
    for(let i=0;i<w.g.length;i++){
      const rr=w.down?w.r+i:w.r, cc=w.down?w.c:w.c+i;
      if(rr===sr && cc===sc) return true;
    }
    return false;
  });
  if(!w) return false;
  for(let i=0;i<w.g.length;i++){
    const rr=w.down?w.r+i:w.r, cc=w.down?w.c:w.c+i;
    if(rr===r && cc===c) return true;
  }
  return false;
}
function xSolvedWords(){
  return XW.words.filter(w=>{
    for(let i=0;i<w.g.length;i++){
      const r=w.down?w.r+i:w.r, c=w.down?w.c:w.c+i;
      if((X.filled[r+","+c]||"")!==w.g[i]) return false;
    }
    return true;
  });
}
function xRender(){
  const solved = xSolvedWords();
  /* Size the squares to the screen. On a phone the grid still scrolls sideways
     a little, which is normal for a crossword, but 34px keeps every square big
     enough to tap without zooming. */
  const avail = Math.min(680, (innerWidth || 900) - 70);
  const size = Math.max(34, Math.min(52, Math.floor(avail / XW.w)));
  const scrolls = size * XW.w > avail;
  stage.innerHTML =
    `<div class="shead"><div><h3>Kenyang crossword</h3>
      <p>Clues are in English, answers in Kenyang. The arrow in each clue square
      shows which way its answer runs. Tone marks are left off in the squares, and
      the full spelling appears when you get a word.</p></div>
      <span class="tag fam">${solved.length} of ${XW.words.length} solved</span></div>`
    + `<div class="xwrap"><div class="xgrid" style="--cs:${size}px;
        grid-template-columns:repeat(${XW.w},${size}px)">${xCells()}</div></div>`
    + (scrolls ? `<p style="text-align:center;font-size:12.5px;color:var(--mute);
        margin:8px 0 0">slide the grid sideways to see the rest</p>` : "")
    + `<p class="xnow" id="xnow"></p>`
    + `<div class="xkeys">` + KEYS.map(k=>`<button class="k" data-k="${esc(k)}">${esc(k)}</button>`).join("")
      + `<button class="k wide" data-k="DEL">delete</button></div>`
    + `<div class="act"><button class="btn" data-xhint>Give me a letter</button>
       <button class="btn solid" data-xcheck>Check the grid</button>
       <button class="btn" data-xclear>Start again</button></div>`;
  xNow();
}
function xNow(){
  const el=$("xnow"); if(!el) return;
  const solved = xSolvedWords();
  if(solved.length === XW.words.length){
    el.innerHTML = `All ten. Now read them out loud to whoever is next to you.`;
    return;
  }
  if(!X.sel){ el.textContent = "Tap a square to start."; return; }
  const [r,c]=X.sel.split(",").map(Number);
  const w = XW.words.find(w=>{
    for(let i=0;i<w.g.length;i++){
      const rr=w.down?w.r+i:w.r, cc=w.down?w.c:w.c+i;
      if(rr===r&&cc===c&&w.down===(X.dir==="down")) return true;
    }
    return false;
  }) || XW.words.find(w=>{
    for(let i=0;i<w.g.length;i++){
      const rr=w.down?w.r+i:w.r, cc=w.down?w.c:w.c+i;
      if(rr===r&&cc===c) return true;
    }
    return false;
  });
  if(!w){ el.textContent=""; return; }
  const done = solved.includes(w);
  el.innerHTML = done
    ? `${esc(w.clue)} is <b>${esc(w.w)}</b>. That is how it is really written.`
    : `${esc(w.clue)}, ${w.g.length} letters, ${w.down?"downwards":"across"}.`;
}
function xAdvance(){
  if(!X.sel) return;
  let [r,c]=X.sel.split(",").map(Number);
  for(let n=0;n<XW.w+XW.h;n++){
    if(X.dir==="across") c++; else r++;
    const k=r+","+c;
    if(X.letters[k]){ X.sel=k; return; }
    if(r>=XW.h||c>=XW.w) return;
  }
}

/* ── the duel ────────────────────────────────────────────────── */
let D = null;
const ALL_WORDS = STEPS.flatMap(s=>s.words.map(w=>[w[0],w[1]]));
function duelInit(){
  D = {turn:0, score:[0,0], n:0, rounds:10, q:null, names:S.names.slice()};
}
function duelRender(){
  if(D.n >= D.rounds) return duelEnd();
  const answer = pick(ALL_WORDS);
  const others = shuffle(ALL_WORDS.filter(w=>w[1]!==answer[1])).slice(0,3);
  D.q = {answer};
  const t = D.turn;
  stage.innerHTML =
    `<div class="shead"><div><h3>Family duel</h3>
      <p>Ten questions, taking turns. Tap a name to change it. Whoever is behind
      gets to pick the next activity.</p></div></div>`
    + `<div class="duel">
        <div class="pl pA ${t===0?"turn":""}">
          <p class="nm"><button class="lvl" data-rename="0"
             style="padding:2px 10px;font-size:12px">${esc(D.names[0])}</button></p>
          <p class="sc">${D.score[0]}</p></div>
        <div class="pl pB ${t===1?"turn":""}">
          <p class="nm"><button class="lvl" data-rename="1"
             style="padding:2px 10px;font-size:12px">${esc(D.names[1])}</button></p>
          <p class="sc">${D.score[1]}</p></div></div>`
    + `<p class="whoseturn">Question ${D.n+1} of ${D.rounds}.
        <b style="color:${t===0?"var(--p1)":"var(--p2)"}">${esc(D.names[t])}</b>, your turn.</p>`
    + `<p class="ask" style="color:var(--place)">${esc(answer[0])}</p>`
    + `<p class="askhint">What does this mean?</p>`
    + `<div class="choices">` + shuffle([answer,...others]).map(o=>
        `<button class="choice" data-den="${esc(o[1])}">${esc(o[1])}</button>`).join("")
    + `</div>`;
}
function duelEnd(){
  const [a,b]=D.score;
  const msg = a===b ? "A draw. Play again to settle it."
    : `${a>b?D.names[0]:D.names[1]} wins.`;
  stage.innerHTML = `<div class="final">
      <p class="n">${a} <span style="color:var(--mute);font-size:.6em">to</span> ${b}</p>
      <p>${esc(msg)}</p></div>
    <div class="act"><button class="btn solid" data-dagain>Play again</button></div>`;
}

/* ── build the sentence, alone ───────────────────────────────── */
let B = null;
function buildNew(){
  if(B && B.n >= 8) return buildEnd();
  const st = {who:Math.floor(Math.random()*WHO.length),
              when:Math.random()<.5?1:0, not:Math.random()<.5,
              place:Math.random()<.6?1+Math.floor(Math.random()*(PLACE.length-1)):0,
              verb:Math.floor(Math.random()*VERBS.length)};
  const who=WHO[st.who], parts=[who.ken];
  if(st.not) parts.push("pú");
  parts.push(VERBS[st.verb].ken);
  if(st.when) parts.push("nyaka");
  if(st.place) parts.push(PLACE[st.place].ken);
  const en = `${who.en} ${who.be[st.when?1:0]}${st.not?" not":""} `
    + VERBS[st.verb].en + (st.place?" "+PLACE[st.place].en:"");
  const role={"pú":"not","nyaka":"when"};
  WHO.forEach(w=>role[w.ken]="who");
  VERBS.forEach(v=>role[v.ken]="root");
  PLACE.forEach(p=>{if(p.ken) role[p.ken]="place";});
  const extras = shuffle([...WHO.map(w=>w.ken),"nyaka","pú",
    ...PLACE.filter(p=>p.ken).map(p=>p.ken)].filter(w=>!parts.includes(w))).slice(0,2);
  B.t={ken:parts,en}; B.chosen=[];
  stage.innerHTML =
    `<div class="shead"><div><h3>Build the sentence</h3>
      <p>The order never changes: who, then not, then the verb, then when,
      then where.</p></div></div>`
    + `<div class="bar"><span>Question ${B.n+1} of 8</span>
       <span class="pbar"><i style="width:${(B.n/8)*100}%"></i></span>
       <span style="color:var(--place)">${B.score} right</span></div>`
    + `<p class="ask">${esc(en)}</p><p class="askhint">Tap them into the right order</p>`
    + `<div class="slotrow" id="slots" style="display:flex;flex-wrap:wrap;gap:8px;
        justify-content:center;min-height:60px;align-items:center;padding:13px;
        border:1px dashed var(--edge-hi);border-radius:14px;margin:0 0 18px"></div>`
    + `<div style="display:flex;flex-wrap:wrap;gap:9px;justify-content:center">`
    + shuffle([...parts,...extras]).map((w,i)=>
        `<button class="choice" style="font-size:20px;min-height:0;padding:12px 18px;
          color:var(--${role[w]==="root"?"root":role[w]})"
          data-tile="${i}" data-w="${esc(w)}">${esc(w)}</button>`).join("")
    + `</div><div class="act"><button class="btn" data-bundo>Undo</button>
       <button class="btn solid" data-bcheck>Check it</button></div>`;
}
function buildEnd(){
  stage.innerHTML = `<div class="final"><p class="n">${B.score} / 8</p>
    <p>${B.score>=6?"That is the rule working.":"Try once more. The order is always the same."}</p></div>
    <div class="act"><button class="btn solid" data-bagain>Play again</button></div>`;
}

function runActivity(){
  document.querySelectorAll(".pickc").forEach(c=>
    c.setAttribute("aria-selected", c.dataset.pick===A.id?"true":"false"));
  if(A.id==="xw"){ if(!X) xInit(); xRender(); }
  else if(A.id==="duel"){ duelInit(); duelRender(); }
  else { B={n:0,score:0}; buildNew(); }
}

/* one handler for everything inside the activity stage */
stage.addEventListener("click", e=>{
  const b = e.target.closest("button"); if(!b) return;

  /* crossword */
  if(b.dataset.cell){
    if(X.sel===b.dataset.cell) X.dir = X.dir==="across"?"down":"across";
    X.sel=b.dataset.cell; X.checked=false; xRender(); return;
  }
  if(b.dataset.k){
    if(!X.sel) return;
    if(b.dataset.k==="DEL"){ delete X.filled[X.sel]; }
    else { X.filled[X.sel]=b.dataset.k; xAdvance(); }
    X.checked=false; xRender(); return;
  }
  if(b.dataset.xcheck!==undefined){ X.checked=true; xRender(); return; }
  if(b.dataset.xclear!==undefined){ xInit(); xRender(); return; }
  if(b.dataset.xhint!==undefined){
    const empty = Object.keys(X.letters).filter(k=>X.filled[k]!==X.letters[k]);
    if(empty.length){ const k=pick(empty); X.filled[k]=X.letters[k]; X.sel=k; }
    X.checked=false; xRender(); return;
  }

  /* duel */
  if(b.dataset.rename!==undefined){
    const i=+b.dataset.rename;
    const v=prompt("Who is playing?", D.names[i]);
    if(v && v.trim()){ D.names[i]=v.trim().slice(0,14); S.names=D.names.slice(); save(); }
    duelRender(); return;
  }
  if(b.dataset.den!==undefined){
    const right=D.q.answer, ok=b.dataset.den===right[1];
    if(ok) D.score[D.turn]++;
    stage.querySelectorAll(".choice").forEach(c=>{
      c.disabled=true;
      if(c.dataset.den===right[1]) c.classList.add("right");
      else if(c===b) c.classList.add("wrong");
    });
    stage.insertAdjacentHTML("beforeend",
      `<div class="verdict ${ok?"ok":"no"}">`+(ok
        ? `Yes. <b>${esc(right[0])}</b> is ${esc(right[1])}.`
        : `Not that one. <b>${esc(right[0])}</b> is ${esc(right[1])}.`)
      +`</div><div class="act"><button class="btn solid" data-dnext>Next</button></div>`);
    return;
  }
  if(b.dataset.dnext!==undefined){ D.n++; D.turn=1-D.turn; duelRender(); return; }
  if(b.dataset.dagain!==undefined){ duelInit(); duelRender(); return; }

  /* build */
  if(b.dataset.tile!==undefined){
    B.chosen.push(b.dataset.w); b.disabled=true;
    $("slots").insertAdjacentHTML("beforeend",
      `<span style="font-family:var(--serif);font-size:19px;padding:8px 14px;
       border-radius:10px;background:var(--lift2);border:1px solid var(--edge)"
       >${esc(b.dataset.w)}</span>`);
    return;
  }
  if(b.dataset.bundo!==undefined){
    const last=B.chosen.pop(); if(last===undefined) return;
    $("slots").lastElementChild.remove();
    const t=[...stage.querySelectorAll("[data-tile]")].find(x=>x.dataset.w===last&&x.disabled);
    if(t) t.disabled=false; return;
  }
  if(b.dataset.bcheck!==undefined){
    const ok = B.chosen.length===B.t.ken.length && B.chosen.every((w,i)=>w===B.t.ken[i]);
    if(ok) B.score++;
    B.n++;
    stage.querySelectorAll("[data-tile],[data-bcheck],[data-bundo]").forEach(x=>x.disabled=true);
    stage.insertAdjacentHTML("beforeend",
      `<div class="verdict ${ok?"ok":"no"}">`+(ok
        ? `Yes. <b>${esc(B.t.ken.join(" "))}</b>`
        : `Not quite. It is <b>${esc(B.t.ken.join(" "))}</b>.`)
      +`</div><div class="act"><button class="btn solid" data-bnext>Next</button></div>`);
    return;
  }
  if(b.dataset.bnext!==undefined){ buildNew(); return; }
  if(b.dataset.bagain!==undefined){ B={n:0,score:0}; buildNew(); return; }
});

/* physical keyboard for the crossword, because adults will use one */
addEventListener("keydown", e=>{
  if(A.id!=="xw" || !X || !X.sel) return;
  if(e.key==="Backspace"){ delete X.filled[X.sel]; X.checked=false; xRender(); e.preventDefault(); return; }
  const up=e.key.toUpperCase();
  if(KEYS.includes(up)){ X.filled[X.sel]=up; xAdvance(); X.checked=false; xRender(); }
});

paintPicks(); runActivity();

/* ═══════════════════════════════════════════════════════════════════════════
   4 · THE STEPS, FOR LEARNING ALONE
   ═══════════════════════════════════════════════════════════════════════════ */
let L={step:0, phase:"learn", n:0, score:0, q:null};
const ROUNDS=6, PASS=4;
function paintPath(){
  $("pathGrid").innerHTML = STEPS.map((s,i)=>
    `<button class="step ${S.done[s.id]>=2?"done":""}" data-step="${i}" role="tab"
      aria-selected="${L.step===i}"><span class="tick" aria-hidden="true">✓</span>
      <p class="sn">${s.n.toUpperCase()}</p><h4>${s.title}</h4></button>`).join("");
  document.querySelectorAll(".step").forEach(c=>
    c.addEventListener("click",()=>{L.step=+c.dataset.step; L.phase="learn"; renderL();}));
}
function renderL(){
  const s=STEPS[L.step]; paintPath();
  const head=`<div class="shead"><div><h3>${s.title}</h3><p>${s.sub}</p></div></div>`;
  if(L.phase==="learn"){
    $("lesson").innerHTML = head + `<div class="wordlist">` + s.words.map(w=>
      `<div class="wcard"><p class="kk">${esc(w[0])}</p><p class="ee">${esc(w[1])}</p>
       ${w[2]?`<p class="nn">${esc(w[2])}</p>`:""}</div>`).join("")
      + `</div><div class="act"><button class="btn solid" data-lgo>I have read them</button></div>`;
    return;
  }
  if(L.phase==="practise"){
    if(L.n>=ROUNDS){ if(L.score>=PASS&&(S.done[s.id]||0)<1){S.done[s.id]=1;save();}
      L.phase="mission"; return renderL(); }
    const pool=s.words.map(w=>[w[0],w[1]]);
    const answer=pick(pool);
    let others=shuffle(pool.filter(w=>w[1]!==answer[1])).slice(0,3);
    while(others.length<3){
      const x=pick(ALL_WORDS.filter(w=>w[1]!==answer[1]&&!others.some(o=>o[1]===w[1])));
      if(!x) break; others.push(x);
    }
    L.q={answer};
    $("lesson").innerHTML = head
      + `<div class="bar"><span>Question ${L.n+1} of ${ROUNDS}</span>
         <span class="pbar"><i style="width:${(L.n/ROUNDS)*100}%"></i></span>
         <span style="color:var(--place)">${L.score} right</span></div>`
      + `<p class="ask" style="color:var(--place)">${esc(answer[0])}</p>`
      + `<p class="askhint">What does this mean?</p><div class="choices">`
      + shuffle([answer,...others]).map(o=>
          `<button class="choice" data-len="${esc(o[1])}">${esc(o[1])}</button>`).join("")
      + `</div>`;
    return;
  }
  $("lesson").innerHTML = head
    + `<div class="final"><p class="n">${L.score} / ${ROUNDS}</p>
       <p>Now the part that actually matters.</p></div>`
    + `<div class="mission"><span class="mi" aria-hidden="true">🏠</span>
       <span class="mt">${s.mission}</span></div>`
    + `<div class="act"><button class="btn fam" data-lmission>${
        S.done[s.id]>=2?"You did it ✓":"I did it"}</button>`
    + (L.step<STEPS.length-1?`<button class="btn" data-lnext>Next step</button>`:"")
    + `</div>`;
}
$("lesson").addEventListener("click", e=>{
  const b=e.target.closest("button"); if(!b) return;
  if(b.dataset.lgo!==undefined){ L.phase="practise"; L.n=0; L.score=0; renderL(); return; }
  if(b.dataset.lnext!==undefined){ L.step=Math.min(L.step+1,STEPS.length-1);
    L.phase="learn"; renderL(); return; }
  if(b.dataset.lmission!==undefined){ S.done[STEPS[L.step].id]=2; save(); renderL(); return; }
  if(b.dataset.lnextq!==undefined){ L.n++; renderL(); return; }
  if(b.dataset.len!==undefined){
    const right=L.q.answer, ok=b.dataset.len===right[1];
    if(ok) L.score++;
    $("lesson").querySelectorAll(".choice").forEach(c=>{
      c.disabled=true;
      if(c.dataset.len===right[1]) c.classList.add("right");
      else if(c===b) c.classList.add("wrong");
    });
    $("lesson").insertAdjacentHTML("beforeend",
      `<div class="verdict ${ok?"ok":"no"}">`+(ok
        ? `Yes. <b>${esc(right[0])}</b> is ${esc(right[1])}.`
        : `Not that one. <b>${esc(right[0])}</b> is ${esc(right[1])}.`)
      +`</div><div class="act"><button class="btn solid" data-lnextq>Next</button></div>`);
  }
});
renderL();

/* ═══════════════════════════════════════════════════════════════════════════
   5 · ASK YOUR FAMILY, NUMBERS, CHAT, ATMOSPHERE
   ═══════════════════════════════════════════════════════════════════════════ */
/* ═══════════════════════════════════════════════════════════════════════════
   WORDS OF THE WEEK, AND TEACHING NƐPƐM

   Six words rotate by week number rather than at random, so every family sees
   the same six and can talk about them.

   Submissions go straight from this page into the database. The key below can
   only INSERT, never read, because of the row level security policy on the
   table. So a person who digs it out of this file cannot pull the table back
   and read contributors' names. Reading happens on the review page, with a
   different key that never leaves the server.
   ═══════════════════════════════════════════════════════════════════════════ */

/*  ▸▸ PUT YOUR SUPABASE VALUES HERE ◂◂
    url : Project Settings → Data API → the base URL, no /rest/v1 on the end
    key : Project Settings → API Keys → the publishable / anon one
    If these are left blank the forms still work and say plainly that nothing
    was saved, rather than pretending it went somewhere.                      */
const SUPA = {
  url: "https://xkrjlihldrrwyeglszyg.supabase.co",
  key: "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhrcmpsaWhsZHJyd3llZ2xzenlnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAxNjA0MTAsImV4cCI6MjEwNTczNjQxMH0.beVrzxSzO8IEZueiSw5J9Y4_IPprPyZ5pG25bsTIWXA"
};

function weekNumber(){
  const d = new Date();
  const t = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
  t.setUTCDate(t.getUTCDate() + 4 - (t.getUTCDay() || 7));
  const first = new Date(Date.UTC(t.getUTCFullYear(), 0, 1));
  return Math.ceil(((t - first) / 86400000 + 1) / 7);
}
function weekWords(){
  const wk = weekNumber(), out = [], n = GAPS.length;
  for (let i = 0; i < 6; i++) out.push(GAPS[(wk * 6 + i) % n]);
  return out;
}

/* one id per submission, the same shape the Streamlit side makes */
function newId(){
  return ([...crypto.getRandomValues(new Uint8Array(6))]
    .map(b => b.toString(16).padStart(2, "0")).join(""));
}

async function sendToSupabase(row){
  if (!SUPA.url || !SUPA.key){
    return {ok:false, why:"nothing is connected yet, so this was not saved"};
  }
  try {
    const r = await fetch(SUPA.url.replace(/\/$/, "") + "/rest/v1/submissions", {
      method: "POST",
      headers: {
        "apikey": SUPA.key,
        "Authorization": "Bearer " + SUPA.key,
        "Content-Type": "application/json",
        "Prefer": "return=minimal"
      },
      body: JSON.stringify(row)
    });
    if (r.ok) return {ok:true};
    return {ok:false, why:"the database said " + r.status};
  } catch (e){
    return {ok:false, why:"could not reach the database"};
  }
}

function paintWeek(){
  const six = weekWords();
  const found = six.filter(([en]) => S.fam[en]).length;
  $("weekno").textContent = "WEEK " + weekNumber();
  $("weekbar").style.width = (found / 6 * 100) + "%";
  $("weekcount").textContent = found === 6 ? "all six answered"
                                           : `${found} of 6 answered`;
  $("wgrid").innerHTML = six.map(([en, hint]) => {
    const got = S.fam[en];
    return `<div class="wcardx ${got ? "found" : ""}">
      <p class="en">${esc(en)}</p>
      <p class="hint">${esc(hint)}</p>
      <p class="ken">${esc(got || "")}</p>
      <div class="wbtns">
        ${got
          ? `<button data-useit="${esc(en)}">Ask Nɛpɛm to use it</button>
             <button data-open="${esc(en)}">Send a better one</button>`
          : `<button class="go" data-open="${esc(en)}">I know this one</button>`}
      </div></div>`;
  }).join("");
}

/* ── the teach form ─────────────────────────────────────────────── */
function openTeach(english){
  $("tfEn").value = english || "";
  $("tfKen").value = S.fam[english] || "";
  $("tfMsg").innerHTML = "";
  $("tfTitle").textContent = english
    ? `What is the Kenyang for “${english}”?`
    : "What is the Kenyang for this?";
  showForm("teach");
}
/* Only one form open at a time, so the page never has two competing sets of
   fields on screen. Opening one closes the other. */
function showForm(which){
  const t = $("tform"), r = $("rform");
  const openT = which === "teach", openR = which === "wrong";
  t.style.display = openT ? "" : "none";
  r.style.display = openR ? "" : "none";
  $("btnTeach").setAttribute("aria-expanded", openT ? "true" : "false");
  $("btnWrong").setAttribute("aria-expanded", openR ? "true" : "false");
  const shown = openT ? t : openR ? r : null;
  if (shown){
    shown.scrollIntoView({block:"center", behavior:"smooth"});
    setTimeout(() => (openT ? $("tfKen") : $("rfQ")).focus(), 350);
  }
}
$("btnTeach").addEventListener("click", () => {
  const already = $("btnTeach").getAttribute("aria-expanded") === "true";
  if (already){ showForm(null); return; }
  $("tfTitle").textContent = "What is the Kenyang for this?";
  $("tfEn").value = ""; $("tfKen").value = ""; $("tfMsg").innerHTML = "";
  showForm("teach");
});
$("btnWrong").addEventListener("click", () => {
  const already = $("btnWrong").getAttribute("aria-expanded") === "true";
  showForm(already ? null : "wrong");
});
$("tfCancel").addEventListener("click", () => showForm(null));
$("rfCancel").addEventListener("click", () => showForm(null));

/* ── the contributors' door ───────────────────────────────────────
   The review page lives in the tutor and has its own password gate. This only
   says so before sending anybody there, rather than letting somebody click
   through and meet a bare password box with no explanation. */
$("doorBtn").addEventListener("click", () => {
  const m = $("doorMsg");
  const url = CHAT_URL.replace(/\/+$/, "") + "/Review";
  m.innerHTML = `This is only for verified contributors. You will be asked for a
    password on the next page.<br><br>
    <a href="${url}" target="_blank" rel="noopener"
       style="color:var(--place);font-weight:600">Go to the review page &rarr;</a>
    <span style="color:var(--mute)"> &nbsp;or if you have taught Nɛpɛm something
    and would like to help review, write to
    <a href="mailto:agboredouard51@gmail.com" style="color:var(--place)">
    agboredouard51@gmail.com</a>.</span>`;
  m.classList.add("show");
});

$("tfSend").addEventListener("click", async () => {
  const en = $("tfEn").value.trim(), ken = $("tfKen").value.trim();
  const msg = $("tfMsg");
  if (!ken){
    msg.innerHTML = `<div class="fmsg bad">The Kenyang is the part Nɛpɛm needs.
      Nothing was sent.</div>`;
    return;
  }
  $("tfSend").disabled = true;
  $("tfSend").textContent = "Sending…";

  /* keep it on this device too, so the card shows it straight away */
  if (en){ S.fam[en] = ken; save(); paintWeek(); }

  const res = await sendToSupabase({
    id: newId(), kind: "new_word", question: en, answer: "",
    correction: ken, note: $("tfNote").value.trim(),
    speaker: $("tfWho").value.trim(), village: $("tfVil").value.trim(),
    source: "words of the week", status: "new"
  });

  $("tfSend").disabled = false;
  $("tfSend").textContent = "Send it";
  if (res.ok){
    msg.innerHTML = `<div class="fmsg ok">Thank you. <b>${esc(ken)}</b> has been
      written down. A speaker reads every one of these before Nɛpɛm teaches it
      to anybody.</div>`;
    $("tfNote").value = "";
    loadWall();
  } else {
    msg.innerHTML = `<div class="fmsg bad">It was kept on this device, but
      ${esc(res.why)}. Please also send it to
      <a href="mailto:agboredouard51@gmail.com?subject=Kenyang: ${encodeURIComponent(en)}"
         style="color:var(--place)">agboredouard51@gmail.com</a>
      so it is not lost.</div>`;
  }
});

/* ── the report form ────────────────────────────────────────────── */
$("rfSend").addEventListener("click", async () => {
  const ken = $("rfK").value.trim(), msg = $("rfMsg");
  if (!ken){
    msg.innerHTML = `<div class="fmsg bad">Nɛpɛm needs to know what it should
      have said. Nothing was sent.</div>`;
    return;
  }
  $("rfSend").disabled = true;
  $("rfSend").textContent = "Sending…";
  const res = await sendToSupabase({
    id: newId(), kind: "correction",
    question: $("rfQ").value.trim(), answer: $("rfA").value.trim(),
    correction: ken, note: $("rfN").value.trim(),
    speaker: $("rfWho").value.trim(), village: $("rfVil").value.trim(),
    source: "website", status: "new"
  });
  $("rfSend").disabled = false;
  $("rfSend").textContent = "Send the correction";
  if (res.ok){
    msg.innerHTML = `<div class="fmsg ok">Thank you. This is the most useful
      thing anybody sends. A speaker will read it before anything changes.</div>`;
    ["rfQ","rfA","rfK","rfN"].forEach(id => $(id).value = "");
    loadWall();
  } else {
    msg.innerHTML = `<div class="fmsg bad">Nothing was saved, because
      ${esc(res.why)}. Please send it to
      <a href="mailto:agboredouard51@gmail.com?subject=Nepem got something wrong"
         style="color:var(--place)">agboredouard51@gmail.com</a> instead.</div>`;
  }
});

/* ── who has taught him ─────────────────────────────────────────── */
async function loadWall(){
  const list = $("wallList"), note = $("wallNote");
  if (!SUPA.url || !SUPA.key){
    list.innerHTML = "";
    note.textContent = "The list of contributors appears here once the database "
      + "is connected.";
    return;
  }
  try {
    const r = await fetch(
      SUPA.url.replace(/\/$/, "") + "/rest/v1/contributors?select=*",
      { headers: { "apikey": SUPA.key, "Authorization": "Bearer " + SUPA.key } });
    if (!r.ok) throw 0;
    const rows = await r.json();
    if (!rows.length){
      list.innerHTML = "";
      note.textContent = "Nobody yet. The first name here could be yours.";
      return;
    }
    list.innerHTML = rows.map(p => `<span class="gave">
        ${esc(p.speaker)}
        ${p.village ? `<span class="v">${esc(p.village)}</span>` : ""}
        <span class="n">${p.taught}</span></span>`).join("");
    const total = rows.reduce((a, p) => a + Number(p.taught || 0), 0);
    note.textContent = `${rows.length} ${rows.length === 1 ? "person" : "people"} `
      + `have taught Nɛpɛm ${total} ${total === 1 ? "thing" : "things"} between them. `
      + "Only names given with a submission appear here, and only once a speaker "
      + "has confirmed the word.";
  } catch (e){
    list.innerHTML = "";
    note.textContent = "The contributors list could not be read just now.";
  }
}

/* one handler for the week cards */
document.addEventListener("click", e => {
  const open = e.target.closest("[data-open]");
  if (open){ openTeach(open.dataset.open); return; }
  const use = e.target.closest("[data-useit]");
  if (use){ openPaneWith("use", use.dataset.useit, S.fam[use.dataset.useit]); return; }
});

paintWeek(); loadWall();

let P={thing:0,count:2};
$("numgrid").innerHTML = NUMBERS.map(([d,k],i)=>
  `<button class="num" data-num="${i}"><span class="d">${d}</span>
    <span class="kx">${esc(k)}</span></button>`).join("");
$("numgrid").addEventListener("click", e=>{
  const b=e.target.closest("[data-num]"); if(!b) return;
  [...$("numgrid").children].forEach(c=>c.classList.remove("on"));
  b.classList.add("on");
  const i=+b.dataset.num; if(i<5){ P.count=i+1; paintPlural(); }
});
function paintPlural(){
  const t=PLURALS[P.thing], n=P.count, one=n===1;
  $("plRow").innerHTML=`<span class="n1">${esc(one?t.one:t.many)}</span>
    <span class="n2">${esc(NUMBERS[n-1][1])}</span>`;
  $("plEn").textContent=`${n} ${one?t.en1:t.en2}. The number comes after the thing, `
    +`and the thing changes shape.`;
  $("plThings").innerHTML=PLURALS.map((p,i)=>
    `<button class="lvl" data-thing="${i}" aria-pressed="${P.thing===i}">${esc(p.en1)}</button>`).join("");
  $("plCounts").innerHTML=[1,2,3,4,5].map(c=>
    `<button class="lvl" data-count="${c}" aria-pressed="${P.count===c}">${c}</button>`).join("");
}
document.addEventListener("click", e=>{
  const th=e.target.closest("[data-thing]"), ct=e.target.closest("[data-count]");
  if(th){P.thing=+th.dataset.thing; paintPlural();}
  if(ct){P.count=+ct.dataset.count; paintPlural();}
});
paintPlural();

/* ═══════════════════════════════════════════════════════════════════════════
   NƐPƐM'S CORNER

   Three states, and the order matters for cost:
     1. greeting   plain HTML, shown on arrival, free and instant
     2. pane       small window in the corner, iframe loads HERE for the first
                   time, so only people who actually tap wake the container
     3. big        the same element made full screen. Same DOM node, so the
                   conversation is not lost and the iframe does not reload.
   ═══════════════════════════════════════════════════════════════════════════ */
const CHAT_URL = $("newTab").href;
let chatLoaded = false;

function loadChat(){
  if (chatLoaded) return;
  const f = document.createElement("iframe");
  f.src = CHAT_URL + (CHAT_URL.includes("?") ? "&" : "?") + "embed=true";
  f.title = "Nɛpɛm, the Kenyang tutor";
  f.addEventListener("load", () => {
    const w = $("waking"); if (w) w.remove();
    $("pstat").textContent = "here with you";
  });
  $("chatBody").appendChild(f);
  chatLoaded = true;
  $("pstat").textContent = "waking up";
  setTimeout(() => {
    const w = $("waking");
    if (w) w.innerHTML = `<p style="margin:0">He is slow to wake.<br>
      <a href="${CHAT_URL}" target="_blank" rel="noopener"
         style="color:var(--place)">Open him in a new tab instead &rarr;</a></p>`;
  }, 25000);
}

function hideGreet(){
  const g = $("greet");
  if (g) g.style.display = "none";
  $("drum").classList.add("quiet");      // stop the pulse once he has been seen
}

/* Open the chat carrying a word, so the Streamlit app can pick it up from the
   query string and either show the teach form already filled in, or ask Nɛpɛm
   to use the word in a sentence. This is the join between the two halves: the
   website gathers intent, the app does the storing. */
function openPaneWith(mode, english, kenyang){
  const q = new URLSearchParams({ embed:"true", mode, word: english });
  if (kenyang) q.set("ken", kenyang);
  const url = CHAT_URL + (CHAT_URL.includes("?") ? "&" : "?") + q.toString();
  hideGreet();
  const pane = $("pane");
  const old = $("chatBody").querySelector("iframe");
  if (old) old.remove();                 // carrying a new word means a new load
  chatLoaded = false;
  const f = document.createElement("iframe");
  f.src = url;
  f.title = "Nɛpɛm, the Kenyang tutor";
  $("chatBody").appendChild(f);
  chatLoaded = true;
  pane.classList.add("open", "big");
  document.body.style.overflow = "hidden";
  $("paneBig").innerHTML = "&#9724;";
}

function openPane(big){
  hideGreet();
  const p = $("pane");
  p.classList.add("open");
  if (big) p.classList.add("big");
  loadChat();
}
function shutPane(){
  $("pane").classList.remove("open", "big");
  document.body.style.overflow = "";
}

$("drum").addEventListener("click", () => {
  const p = $("pane");
  if (p.classList.contains("open")) shutPane(); else openPane(false);
});
$("greetShut").addEventListener("click", e => { e.stopPropagation(); hideGreet(); });
document.querySelectorAll("[data-ask]").forEach(b =>
  b.addEventListener("click", () => openPane(false)));

$("paneShut").addEventListener("click", shutPane);
$("paneBig").addEventListener("click", () => {
  const p = $("pane"), big = p.classList.toggle("big");
  document.body.style.overflow = big ? "hidden" : "";
  $("paneBig").innerHTML = big ? "&#9724;" : "&#9713;";
  $("paneBig").title = big ? "Make it smaller" : "Make it bigger";
});

/* the button in the nav opens the big version, since that is what someone who
   came looking for the tutor is after */
$("openChat").addEventListener("click", () => {
  openPane(true);
  document.body.style.overflow = "hidden";
  $("paneBig").innerHTML = "&#9724;";
});

addEventListener("keydown", e => { if (e.key === "Escape") shutPane(); });

/* He waits a moment before speaking, so the page has settled first. Once he
   has been greeted in this browser he stays quiet, because a greeting that
   fires on every single visit stops feeling like a greeting. */
try {
  if (!sessionStorage.getItem("nepem.greeted")) {
    $("greet").style.display = "none";
    setTimeout(() => {
      const g = $("greet");
      if (g && !$("pane").classList.contains("open")) g.style.display = "";
      sessionStorage.setItem("nepem.greeted", "1");
    }, 2200);
  } else {
    $("greet").style.display = "none";
    $("drum").classList.add("quiet");
  }
} catch(e){ /* private browsing refuses storage; he just greets every time */ }

const calm=matchMedia("(prefers-reduced-motion: reduce)").matches;
const fine=matchMedia("(hover: hover)").matches;
if(fine&&!calm){
  let frame;
  addEventListener("pointermove",e=>{
    if(frame) return;
    frame=requestAnimationFrame(()=>{frame=null;
      document.documentElement.style.setProperty("--mx",e.clientX+"px");
      document.documentElement.style.setProperty("--my",e.clientY+"px");});
  },{passive:true});
}
if(!calm){
  const c=$("field"), x=c.getContext("2d");
  const GLYPH=["ɛ","ɔ","ŋ","ɨ","ʉ","á","à","ǎ","ɛ́","ɔ́"];
  const HUE=["rgba(66,227,188,","rgba(185,139,255,","rgba(255,106,85,","rgba(255,201,77,"];
  const g=()=>GLYPH[Math.floor(Math.random()*GLYPH.length)];
  let dots=[],w=0,h=0;
  function size(){
    w=c.width=innerWidth; h=c.height=innerHeight;
    dots=Array.from({length:Math.min(34,Math.round(w*h/44000))},()=>({
      x:Math.random()*w,y:Math.random()*h,g:g(),s:12+Math.random()*15,
      vx:(Math.random()-.5)*.08,vy:-.03-Math.random()*.07,
      a:.022+Math.random()*.045,hue:HUE[Math.floor(Math.random()*HUE.length)]}));
  }
  function tick(){
    x.clearRect(0,0,w,h);
    for(const d of dots){
      d.x+=d.vx; d.y+=d.vy;
      if(d.y<-30){d.y=h+20; d.x=Math.random()*w; d.g=g();}
      if(d.x<-30) d.x=w+20; else if(d.x>w+30) d.x=-20;
      x.font=`${d.s}px "Gentium Book Plus", Georgia, serif`;
      x.fillStyle=d.hue+d.a+")"; x.fillText(d.g,d.x,d.y);
    }
    requestAnimationFrame(tick);
  }
  size(); tick(); addEventListener("resize",size);
}

/* the crossword squares are sized from the screen, so redraw when it changes */
{
  let rt;
  addEventListener("resize", () => {
    if (A.id !== "xw" || !X) return;
    clearTimeout(rt);
    rt = setTimeout(xRender, 180);
  });
}
</script>
</body>
</html>